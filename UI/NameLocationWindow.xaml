<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ChargeKeeper.UI.NameLocationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <!-- Names the detected network when a profile is added for it. -->
    <Grid x:Name="Root" Padding="16,14,16,14" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Name this network location"
                   FontSize="13" FontWeight="SemiBold"
                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

        <StackPanel Grid.Row="1" Spacing="4">
            <TextBox x:Name="NameBox" FontSize="13"/>
            <!-- The MAC and subnet the rule actually matches on; the name above is only a label. -->
            <TextBlock x:Name="MatchKeyText"
                       FontSize="11" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="CancelBtn" Grid.Column="0" Content="Cancel" HorizontalAlignment="Stretch"/>
            <Button x:Name="OkBtn"     Grid.Column="1" Content="Save"   HorizontalAlignment="Stretch"/>
        </Grid>
    </Grid>
</Window>
