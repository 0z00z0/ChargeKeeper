<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ChargeKeeper.UI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ChargeKeeper.UI"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:brand="using:ZeroZero.Brand.WinUI"
    mc:Ignorable="d">

    <!-- Default WinUI chrome, not the popup chrome the other windows use: a popup auto-dismisses on
         focus loss, which would close this window mid-edit. -->
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <NavigationView x:Name="Nav"
                     IsSettingsVisible="False"
                     IsBackButtonVisible="Collapsed"
                     IsTabStop="False"
                     PaneDisplayMode="Left"
                     SelectionChanged="OnNavSelectionChanged">

        <!-- Lets the Mica backdrop through instead of the NavigationView painting its own lighter
             pane and top strip over it. The selection highlight is a separate brush and is
             untouched. -->
        <NavigationView.Resources>
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent"/>
            <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>

            <!-- The single source of truth for the nav icon size. The item template wraps each Icon
                 in a Viewbox bound to NavigationViewItemOnLeftIconBoxHeight, so that resource is
                 aliased to the same value rather than repeating the literal — otherwise the icons
                 are scaled back down to the 16 px default. -->
            <x:Double x:Key="NavIconSize">28</x:Double>
            <StaticResource x:Key="NavigationViewItemOnLeftIconBoxHeight" ResourceKey="NavIconSize"/>
        </NavigationView.Resources>

        <!-- Two-tone icons ship as SVG assets shown through ImageIcon: a PathIcon carries one
             colour only. -->
        <NavigationView.MenuItems>
            <NavigationViewItem Content="General"         Tag="General">
                <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/nav/general.svg" Width="{StaticResource NavIconSize}" Height="{StaticResource NavIconSize}"/></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Smart Charge"     Tag="SmartCharge">
                <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/nav/smart-charge.svg" Width="{StaticResource NavIconSize}" Height="{StaticResource NavIconSize}"/></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Keep Awake"       Tag="KeepAwake">
                <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/nav/keep-awake.svg" Width="{StaticResource NavIconSize}" Height="{StaticResource NavIconSize}"/></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Lid close"        Tag="LidClose">
                <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/nav/lid-close.svg" Width="{StaticResource NavIconSize}" Height="{StaticResource NavIconSize}"/></NavigationViewItem.Icon>
            </NavigationViewItem>            <NavigationViewItem Content="Notifications"    Tag="Notifications">
                <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/nav/notifications.svg" Width="{StaticResource NavIconSize}" Height="{StaticResource NavIconSize}"/></NavigationViewItem.Icon>
            </NavigationViewItem>
            <!-- Network profiles have no nav item of their own: a profile's only effect is which
                 preset gets applied, so the two are unusable apart. -->
            <NavigationViewItem Content="MQTT"             Tag="HomeAssistant">
                <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/nav/mqtt.svg" Width="{StaticResource NavIconSize}" Height="{StaticResource NavIconSize}"/></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="About"            Tag="About">
                <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/nav/about.svg" Width="{StaticResource NavIconSize}" Height="{StaticResource NavIconSize}"/></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <!-- VersionText is filled in the constructor from the assembly version the About box also
             reads, never hard-coded. -->
        <NavigationView.PaneFooter>
            <StackPanel Margin="0,4,0,4">
                <Border Height="1" Margin="16,0,16,8"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                <StackPanel Orientation="Horizontal" Spacing="8"
                            Margin="16,4,16,12" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/AppIcon.png"
                           Width="36" Height="36" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ChargeKeeper" FontSize="12"
                                   FontFamily="{StaticResource BrandFont}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="VersionText" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </NavigationView.PaneFooter>

        <ScrollViewer x:Name="ContentScroller" Padding="20,8,20,12" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="SectionHost">

                <!-- Trims the toolkit's 68 px card floor so single-line rows reserve no extra
                     height; cards carrying a description still grow past it. Scoped to this Grid so
                     it also reaches the rows built in code below. -->
                <Grid.Resources>
                    <x:Double x:Key="SettingsCardMinHeight">52</x:Double>
                </Grid.Resources>

                <StackPanel x:Name="GeneralPanel" Spacing="4">
                    <TextBlock Text="General" Style="{StaticResource SectionHeaderStyle}"/>

                    <controls:SettingsCard Header="Startup delay"
                                            Description="Seconds to wait after sign-in before ChargeKeeper initialises (0 = no delay).">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="StartupDelayCombo" MinWidth="140"
                                      SelectionChanged="OnStartupDelayChanged"/>
                            <local:InfoIcon Subject="Startup delay"
                                            Info="The delay keeps ChargeKeeper off the critical sign-in path. Sign-in completes first, then the app initialises."/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Tray icon style"
                                            Description="How the battery level is drawn in the system tray.">
                        <ComboBox x:Name="IconModeCombo" MinWidth="160" SelectionChanged="OnIconModeChanged">
                            <ComboBoxItem Content="Arc gauge"/>
                            <ComboBoxItem Content="Numeric %"/>
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="History graph range"
                                            Description="Default time span shown in the battery history graph.">
                        <ComboBox x:Name="GraphScaleCombo" MinWidth="160" SelectionChanged="OnGraphScaleChanged">
                            <ComboBoxItem Content="15 minutes"/>
                            <ComboBoxItem Content="1 hour"/>
                            <ComboBoxItem Content="6 hours"/>
                            <ComboBoxItem Content="12 hours"/>
                            <ComboBoxItem Content="1 day"/>
                            <ComboBoxItem Content="1 week"/>
                            <ComboBoxItem Content="14 days"/>
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Downtime gap threshold"
                                            Description="How long a hole in the sample timeline must be before the history graph shows it as a break (0 = none).">
                        <ComboBox x:Name="DowntimeGapCombo" MinWidth="140"
                                  SelectionChanged="OnDowntimeGapChanged"/>
                    </controls:SettingsCard>

                    <Border Style="{StaticResource SectionDividerStyle}"/>
                    <TextBlock Text="Advanced" Style="{StaticResource SubHeaderStyle}"/>
                    <controls:SettingsCard Header="Settings file"
                                            Description="ChargeKeeper stores its configuration in settings.json.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="OpenSettingsFolderBtn" Content="Open settings folder" Click="OnOpenSettingsFolder"/>
                            <Button x:Name="ReloadSettingsBtn" Content="Reload settings from file" Click="OnReloadSettings"/>
                            <local:InfoIcon Subject="the settings file"
                                            Info="Reload reads settings.json again, picking up changes made outside the app: a manual edit, or a file synced in from another machine."/>
                        </StackPanel>
                    </controls:SettingsCard>
                </StackPanel>

                <StackPanel x:Name="SmartChargePanel" Spacing="4" Visibility="Collapsed">
                    <TextBlock Text="Smart Charge" Style="{StaticResource SectionHeaderStyle}"/>

                    <!-- Shown alone when no vendor answered: there is nothing to set and nothing to
                         read back. -->
                    <TextBlock x:Name="NoThresholdInterfaceText"
                               Text="This computer has no charge-limit interface ChargeKeeper supports, so there is nothing to configure here."
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="Collapsed"
                               Margin="0,0,0,12"/>

                    <!-- Replaces everything below on hardware with no numeric threshold. Presets
                         and network profiles are only start and stop percentages, so there every
                         preset would collapse to the same on/off. The text is set in code-behind
                         because the cap figure comes from the vendor. -->
                    <StackPanel x:Name="FixedModeSettings" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="Charge limit" Style="{StaticResource SubHeaderStyle}"/>

                        <!-- Built in code-behind from the vendor's modes, so the firmware owns the
                             option list and its order. A radio group rather than a toggle: a
                             three-state vendor has a middle mode with no on/off equivalent. -->
                        <RadioButtons x:Name="ChargeModeRadios"
                                      SelectionChanged="OnChargeModeSelectionChanged"
                                      Margin="0,0,0,8"/>

                        <TextBlock x:Name="FixedModeText"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,0,12"/>
                    </StackPanel>

                    <!-- Grouped so both hide together on fixed-mode hardware, where neither can be
                         expressed. -->
                    <StackPanel x:Name="NumericThresholdSettings" Spacing="4">
                    <TextBlock Text="Presets" Style="{StaticResource SubHeaderStyle}"/>
                    <StackPanel x:Name="PresetsListPanel" Spacing="4"/>
                    <Button x:Name="AddPresetBtn" Content="Add preset" Click="OnAddPreset" Margin="0,4,0,12"/>

                    <Border Style="{StaticResource SectionDividerStyle}"/>
                    <TextBlock Text="Network profiles" Style="{StaticResource SubHeaderStyle}"/>

                    <controls:SettingsCard Header="Enable network profiles"
                                            Description="Applies a preset automatically when the detected network location changes.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <local:InfoIcon Subject="network profiles"
                                            Info="Matching is by the MAC address and IP subnet of the physical adapter carrying the connection, never by Wi-Fi network name and never by a VPN or virtual switch above it."/>
                            <ToggleSwitch x:Name="NetworkEnabledToggle" OnContent="On" OffContent="Off" Toggled="OnNetworkEnabledToggled"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Current network">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <local:InfoIcon Subject="the current network"
                                            Info="The profile name appears here when one matches. Otherwise the adapter and subnet detected are shown — the same key a new profile would be created from. “No network detected” means nothing resolved at all, and no profile can apply."/>
                            <TextBlock x:Name="CurrentNetworkText" Text="—" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <StackPanel x:Name="NetworkRulesListPanel" Spacing="4"/>
                    <Button x:Name="AddNetworkRuleBtn" Content="Add profile for this network…" Click="OnAddNetworkRule" Margin="0,4,0,12"/>

                    <controls:SettingsCard Header="Unknown-network preset"
                                            Description="Preset applied when network profiles are on and the current network matches none of the profiles above.">
                        <ComboBox x:Name="UnknownPresetCombo" MinWidth="200" SelectionChanged="OnUnknownPresetChanged"/>
                    </controls:SettingsCard>
                    </StackPanel>
                </StackPanel>

                <!-- No time or duration picker anywhere on this page: every span is typed and
                     parsed by KeepAwakeInputParser, and that fast entry is the feature. -->

                <StackPanel x:Name="KeepAwakePanel" Spacing="4" Visibility="Collapsed">
                    <TextBlock Text="Keep Awake" Style="{StaticResource SectionHeaderStyle}"/>

                    <controls:SettingsCard Header="Keep this computer awake"
                                            Description="Stops Windows sleeping while a session runs."
                                            ContentAlignment="Vertical"
                                            HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="8" Margin="0,4,0,4">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <ToggleSwitch x:Name="KeepAwakeToggle" OnContent="On" OffContent="Off" Toggled="OnKeepAwakeToggled"/>
                                <TextBlock x:Name="KeepAwakeRemainingText" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <local:InfoIcon Subject="keeping this computer awake"
                                                Info="A session holds the computer awake until it expires. It ends by itself, and is never restored after a restart."/>
                            </StackPanel>

                            <!-- The dashboard's chip row, with room here for the full wording.
                                 Built in code from KeepAwakePresets. -->
                            <StackPanel x:Name="KeepAwakeChipsPanel" Orientation="Horizontal" Spacing="8"/>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="KeepAwakeCustomBox" MinWidth="180"
                                         PlaceholderText="Custom — 3h, 90m or 17:00"/>
                                <Button x:Name="KeepAwakeCustomStartBtn" Content="Start" Click="OnKeepAwakeCustomStart"/>
                            </StackPanel>
                            <TextBlock x:Name="KeepAwakeCustomEchoText" FontSize="11" Opacity="0.7"/>
                            <TextBlock x:Name="KeepAwakeCustomErrorText" FontSize="11"
                                       TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Keep the display on too"
                                            Description="Also holds the display on while a keep-awake session runs.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <local:InfoIcon Subject="keeping the display on"
                                            Info="This is off by default: the usual case is a long build or download finishing, where the screen may sleep as normal. The change takes effect on the next session, not on one already running."/>
                            <ToggleSwitch x:Name="KeepAwakeDisplayToggle" OnContent="On" OffContent="Off" Toggled="OnKeepAwakeDisplayToggled"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <Border Style="{StaticResource SectionDividerStyle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Presets" Style="{StaticResource SubHeaderStyle}" VerticalAlignment="Center"/>
                        <local:InfoIcon Subject="keep-awake presets"
                                        Info="One “Expires” field defines both the kind and the value: a duration (3h, 90m, 1h30) or a clock time (17:00). The first preset is the one the tray toggle and the dashboard switch use."/>
                    </StackPanel>
                    <StackPanel x:Name="KeepAwakePresetsListPanel" Spacing="4"/>
                    <Button x:Name="AddKeepAwakePresetBtn" Content="Add preset" Click="OnAddKeepAwakePreset" Margin="0,4,0,12"/>

                    <!-- The keep-awake facet of the same rules the Smart Charge page edits. It is
                         repeated here because that page's rows sit inside NumericThresholdSettings,
                         which collapses entirely on fixed-mode hardware where keep-awake-per-network
                         still has to work. -->
                    <Border Style="{StaticResource SectionDividerStyle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Networks" Style="{StaticResource SubHeaderStyle}" VerticalAlignment="Center"/>
                        <local:InfoIcon Subject="keep-awake networks"
                                        Info="The hold starts on arrival at a network and ends on leaving it. These are the same network rules the Smart Charge page uses; this page sets their keep-awake side and that page sets the preset. “Enable network profiles” must be on there for them to act, and deleting a rule removes it from both pages."/>
                    </StackPanel>

                    <controls:SettingsCard Header="Current network">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <local:InfoIcon Subject="the current network"
                                            Info="The profile name appears here when one matches. Otherwise the adapter and subnet detected are shown — the same key a new profile would be created from. “No network detected” means nothing resolved at all, and no profile can apply."/>
                            <TextBlock x:Name="KeepAwakeCurrentNetworkText" Text="—" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <StackPanel x:Name="KeepAwakeNetworkRulesListPanel" Spacing="4"/>
                    <Button x:Name="AddKeepAwakeNetworkRuleBtn" Content="Add profile for this network…"
                            Click="OnAddKeepAwakeNetworkRule" Margin="0,4,0,12"/>
                </StackPanel>
                <!-- The only setting in the app that changes a Windows setting outside it, so the
                     wording is blunt about which setting and how it comes back. -->
                <StackPanel x:Name="LidClosePanel" Spacing="4" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                        <TextBlock Text="Lid close" Style="{StaticResource SectionHeaderStyle}"
                                   Margin="0" VerticalAlignment="Center"/>
                        <local:InfoIcon Subject="lid close"
                                        Info="Activating this sets the Windows lid-close action to “Do nothing”. ChargeKeeper then runs its own sleep timer. The previous Windows setting is restored when this is turned off, or at the next start if the app is killed first. While it is on, movement on a connected mouse can wake the computer with the lid shut. Locking at lid close restores the sign-in prompt the delay would otherwise remove."/>
                    </StackPanel>

                    <controls:SettingsCard Header="Delay sleep after the lid closes"
                                            Description="Waits before sleeping when the lid closes, instead of sleeping at once.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <local:InfoIcon Subject="the lid-close delay"
                                            Info="Opening the lid before the delay is up cancels it. A running keep-awake session suppresses the sleep, so the computer is never slept out from under one."/>
                            <ToggleSwitch x:Name="LidDelayToggle" OnContent="On" OffContent="Off" Toggled="OnLidDelayToggled"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Wait"
                                            Description="How long to stay awake with the lid closed before sleeping.">
                        <ComboBox x:Name="LidDelayMinutesCombo" MinWidth="140" SelectionChanged="OnLidDelayMinutesChanged"/>
                    </controls:SettingsCard>

                    <!-- On by default, and disabled rather than hidden while the delay is off: the
                         delay parks the Windows lid-close action on "do nothing", which also removes
                         the sign-in prompt a lid close normally leads to. This puts it back. -->
                    <controls:SettingsCard Header="Lock the computer when the lid closes"
                                            Description="Locks the computer as soon as the lid closes.">
                        <ToggleSwitch x:Name="LidLockToggle" OnContent="On" OffContent="Off" Toggled="OnLidLockToggled"/>
                    </controls:SettingsCard>
                </StackPanel>

                <StackPanel x:Name="NotificationsPanel" Spacing="4" Visibility="Collapsed">
                    <TextBlock Text="Notifications" Style="{StaticResource SectionHeaderStyle}"/>

                    <controls:SettingsCard Header="Low battery warning"
                                            Description="Notify when the battery drops to this level while discharging.">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ComboBox x:Name="LowBattPctCombo" MinWidth="110"
                                      SelectionChanged="OnLowBattPctChanged"/>
                            <ToggleSwitch x:Name="LowBattEnabledToggle" OnContent="On" OffContent="Off" Toggled="OnLowBattEnabledToggled"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="High battery warning"
                                            Description="Notify when the battery rises to this level.">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <local:InfoIcon Subject="the high battery warning"
                                            Info="The warning fires once on the way up and stays silent until the level falls back below. It is suppressed while Smart Charge is limiting and the level is within its cap, so it means the battery went higher than the cap allows."/>
                            <ComboBox x:Name="HighBattPctCombo" MinWidth="110"
                                      SelectionChanged="OnHighBattPctChanged"/>
                            <ToggleSwitch x:Name="HighBattEnabledToggle" OnContent="On" OffContent="Off" Toggled="OnHighBattEnabledToggled"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Overnight-drain warning"
                                            Description="Notify when the battery loses charge faster than this rate across a detected downtime gap.">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ComboBox x:Name="DrainPctPerHourCombo" MinWidth="110"
                                      SelectionChanged="OnDrainPctPerHourChanged"/>
                            <ToggleSwitch x:Name="DrainEnabledToggle" OnContent="On" OffContent="Off" Toggled="OnDrainEnabledToggled"/>
                        </StackPanel>
                    </controls:SettingsCard>
                </StackPanel>

                <!-- Five sections in the order the questions arise: whether to publish at all, what
                     the connection is doing, which device this is, how it is reached, and what goes
                     out. The last two are collapsed, because both are set once and then left. -->
                <StackPanel x:Name="HomeAssistantPanel" Spacing="4" Visibility="Collapsed">

                    <!-- The alignment contract for the page. Every field is one width, every card
                         right-aligns its content, and an InfoIcon always sits to the LEFT of the
                         field it explains — so no adornment can displace a right edge and the whole
                         column lands on one line without a single per-card measurement. -->
                    <StackPanel.Resources>
                        <x:Double x:Key="MqttFieldWidth">240</x:Double>
                        <Style x:Key="MqttTextFieldStyle" TargetType="TextBox">
                            <Setter Property="Width" Value="{StaticResource MqttFieldWidth}"/>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="TextAlignment" Value="Right"/>
                        </Style>
                        <!-- PasswordBox has no TextAlignment: the masked run follows the control's
                             content alignment instead, which is why this style differs from the
                             TextBox one by a property name rather than by intent. -->
                        <Style x:Key="MqttPasswordFieldStyle" TargetType="PasswordBox">
                            <Setter Property="Width" Value="{StaticResource MqttFieldWidth}"/>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                        </Style>
                        <Style x:Key="MqttComboFieldStyle" TargetType="ComboBox">
                            <Setter Property="Width" Value="{StaticResource MqttFieldWidth}"/>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                        <!-- The one small toned-down label used for every row's sub-text and for the
                             page's status lines, so the secondary tier is defined once. -->
                        <Style x:Key="SettingHintStyle" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </StackPanel.Resources>

                    <!-- The page title. Everything below says "broker": Home Assistant is named once,
                         under Discovery prefix, because that is the published name of the convention
                         and not the name of a dependency. -->
                    <TextBlock Text="MQTT" Style="{StaticResource SectionHeaderStyle}"/>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Publish to MQTT" Style="{StaticResource SubHeaderStyle}" VerticalAlignment="Center"/>
                        <local:InfoIcon Subject="publishing to MQTT"
                                        Info="The master switch for the whole feature. Nothing on the network is touched while it is off, and the rest of this page is hidden because none of it applies."/>
                    </StackPanel>

                    <controls:SettingsCard Header="Publish to MQTT">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="Publishes battery and charge state to an MQTT broker." Style="{StaticResource SettingHintStyle}"/>
                        </controls:SettingsCard.Description>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <local:InfoIcon Subject="the publish switch"
                                            Info="The entities are announced by auto-discovery. This switch applies immediately; the broker fields apply on Apply."/>
                            <ToggleSwitch x:Name="HaEnabledToggle" OnContent="On" OffContent="Off" Toggled="OnHaEnabledToggled"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <!-- Hidden rather than disabled while publishing is off: a greyed page still
                         invites reading, and none of it has an answer until the feature is on. -->
                    <StackPanel x:Name="MqttDetailPanel" Spacing="4">

                        <Border Style="{StaticResource SectionDividerStyle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Status" Style="{StaticResource SubHeaderStyle}" VerticalAlignment="Center"/>
                            <local:InfoIcon Subject="status"
                                            Info="Read-only, and about the live connection rather than the fields below. It is re-read when this page opens, not on a timer."/>
                        </StackPanel>

                        <!-- First in Status because it answers the question the rest of the page
                             raises: whether these values were found or chosen. It also carries the
                             search's progress, so there is one line to watch rather than two. -->
                        <controls:SettingsCard Header="Connection">
                            <controls:SettingsCard.Description>
                                <TextBlock Text="Where the broker settings in force came from." Style="{StaticResource SettingHintStyle}"/>
                            </controls:SettingsCard.Description>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <local:InfoIcon Subject="how the connection was found"
                                                Info="A port and transport left on Automatic are found by probing the host, and the answer is remembered against that host and user name. Setting either by hand pins it, and nothing is probed around it."/>
                                <TextBlock x:Name="HaDetectText" Text="—" VerticalAlignment="Center"
                                           Style="{StaticResource SettingHintStyle}"/>
                            </StackPanel>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="Broker in use">
                            <controls:SettingsCard.Description>
                                <TextBlock Text="The address the live connection is using." Style="{StaticResource SettingHintStyle}"/>
                            </controls:SettingsCard.Description>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <local:InfoIcon Subject="the broker in use"
                                                Info="The saved values, not the ones staged in the fields below. The two differ until Apply is pressed."/>
                                <TextBlock x:Name="HaBrokerStatusText" Text="Not set" VerticalAlignment="Center"
                                           Style="{StaticResource SettingHintStyle}"/>
                            </StackPanel>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="Last publish">
                            <controls:SettingsCard.Description>
                                <TextBlock Text="When a message last reached the broker." Style="{StaticResource SettingHintStyle}"/>
                            </controls:SettingsCard.Description>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <local:InfoIcon Subject="the last publish time"
                                                Info="Unchanged values are not re-sent, so this stands still while nothing changes."/>
                                <TextBlock x:Name="HaLastPublishText" Text="—" VerticalAlignment="Center"
                                           Style="{StaticResource SettingHintStyle}"/>
                            </StackPanel>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="Last command received">
                            <controls:SettingsCard.Description>
                                <TextBlock Text="The most recent command received from the broker." Style="{StaticResource SettingHintStyle}"/>
                            </controls:SettingsCard.Description>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <local:InfoIcon Subject="the last command received"
                                                Info="Commands arrive on the topics the announced entities subscribe to. Nothing is shown until one is acted on."/>
                                <TextBlock x:Name="HaLastCommandText" Text="—" VerticalAlignment="Center"
                                           Style="{StaticResource SettingHintStyle}"/>
                            </StackPanel>
                        </controls:SettingsCard>

                        <!-- Before Broker: which device this is comes before how it connects. The name
                             is cosmetic and rides the Apply batch; the id is destructive and changes
                             only through its own confirmation dialog. -->
                        <Border Style="{StaticResource SectionDividerStyle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Device" Style="{StaticResource SubHeaderStyle}" VerticalAlignment="Center"/>
                            <local:InfoIcon Subject="the device section"
                                            Info="How this machine appears to whatever consumes the entities: one display name, and one identifier every topic is built from."/>
                        </StackPanel>

                        <controls:SettingsCard Header="Device name">
                            <controls:SettingsCard.Description>
                                <TextBlock Text="The display name published for this machine." Style="{StaticResource SettingHintStyle}"/>
                            </controls:SettingsCard.Description>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <local:InfoIcon Subject="the device name"
                                                Info="Cosmetic — it renames nothing else. An empty box falls back to the name derived from this machine, shown as the placeholder."/>
                                <!-- PlaceholderText is the machine-derived default, set in code-behind. -->
                                <TextBox x:Name="HaDeviceNameBox" Style="{StaticResource MqttTextFieldStyle}"/>
                            </StackPanel>
                        </controls:SettingsCard>

                        <!-- Read-only with a button, not a text box: the id is the unique_id stem and
                             every topic segment, so editing it in place would make a rename a
                             side effect of a keystroke. -->
                        <controls:SettingsCard Header="Device ID">
                            <controls:SettingsCard.Description>
                                <TextBlock Text="Identifies this machine in every topic and entity id." Style="{StaticResource SettingHintStyle}"/>
                            </controls:SettingsCard.Description>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <local:InfoIcon Subject="the device ID"
                                                Info="Changing it renames every published entity, so it has a confirmation of its own rather than riding the Apply batch."/>
                                <TextBlock x:Name="HaNodeIdText" VerticalAlignment="Center"
                                           Style="{StaticResource SettingHintStyle}"
                                           IsTextSelectionEnabled="True"/>
                                <Button x:Name="HaChangeNodeIdBtn" Content="Change ID…" Click="OnChangeNodeIdClicked"/>
                            </StackPanel>
                        </controls:SettingsCard>

                        <Border Style="{StaticResource SectionDividerStyle}"/>

                        <controls:SettingsExpander x:Name="MqttBrokerExpander" IsExpanded="False"
                                                   Header="Broker">
                            <controls:SettingsExpander.Description>
                                <TextBlock Text="How the broker is reached. Staged here and applied together."
                                           Style="{StaticResource SettingHintStyle}"/>
                            </controls:SettingsExpander.Description>
                            <local:InfoIcon Subject="the broker section"
                                            Info="These fields are staged locally and take effect on Apply, so the connection is remade once per edit session rather than once per keystroke. Port and transport left on Automatic are found by probing."/>

                            <controls:SettingsExpander.Items>
                                <controls:SettingsCard Header="Host">
                                    <controls:SettingsCard.Description>
                                        <TextBlock Text="The broker's host name or address." Style="{StaticResource SettingHintStyle}"/>
                                    </controls:SettingsCard.Description>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <local:InfoIcon Subject="the broker host"
                                                        Info="A name or an address. A host written as a ws:// or wss:// address is used exactly as typed, which covers a broker served under a path the port alone cannot express."/>
                                        <TextBox x:Name="HaHostBox" Style="{StaticResource MqttTextFieldStyle}"
                                                 PlaceholderText="e.g. 10.0.20.22"/>
                                    </StackPanel>
                                </controls:SettingsCard>

                                <!-- Host then Port then Transport, because that is the order the
                                     answers narrow in: which machine, which door, which language.
                                     The typed box and its error line share the field width, so an
                                     expanded port row keeps the same right edge as every other. -->
                                <controls:SettingsCard Header="Port">
                                    <controls:SettingsCard.Description>
                                        <TextBlock Text="The port the broker listens on." Style="{StaticResource SettingHintStyle}"/>
                                    </controls:SettingsCard.Description>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <local:InfoIcon Subject="the broker port"
                                                        Info="Automatic tries the ports brokers are commonly served on, in turn, and remembers the one that answered. The list covers plain MQTT, MQTT over encryption, and the front-door ports a broker published over WebSocket answers on. The last entry takes a port typed by hand."/>
                                        <StackPanel Spacing="4" HorizontalAlignment="Right">
                                            <ComboBox x:Name="HaPortCombo" Style="{StaticResource MqttComboFieldStyle}"
                                                      SelectionChanged="OnHaPortSelectionChanged"/>
                                            <TextBox x:Name="HaPortCustomBox" Style="{StaticResource MqttTextFieldStyle}"
                                                     Visibility="Collapsed" PlaceholderText="1-65535"/>
                                            <TextBlock x:Name="HaPortErrorText" Visibility="Collapsed"
                                                       Style="{StaticResource SettingHintStyle}"
                                                       Width="{StaticResource MqttFieldWidth}" TextAlignment="Right"/>
                                        </StackPanel>
                                    </StackPanel>
                                </controls:SettingsCard>

                                <!-- Automatic is first so it is the default selection, matching the setting. -->
                                <controls:SettingsCard Header="Transport">
                                    <controls:SettingsCard.Description>
                                        <TextBlock Text="Which protocol carries MQTT to the broker." Style="{StaticResource SettingHintStyle}"/>
                                    </controls:SettingsCard.Description>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <local:InfoIcon Subject="the transport"
                                                        Info="Automatic tries a plain socket first and falls back to WebSocket, then remembers whichever answered and starts there next time — the usual case for a machine that is on the internal network sometimes and outside it at others. An explicit choice is never reached around."/>
                                        <ComboBox x:Name="HaTransportCombo" Style="{StaticResource MqttComboFieldStyle}">
                                            <ComboBoxItem Content="Automatic"/>
                                            <ComboBoxItem Content="TCP"/>
                                            <ComboBoxItem Content="WebSocket"/>
                                        </ComboBox>
                                    </StackPanel>
                                </controls:SettingsCard>

                                <!-- Renamed away from the acronym, and silent about ports: the port is
                                     its own setting now and may be anything the broker is served on. -->
                                <controls:SettingsCard Header="Encrypted connection">
                                    <controls:SettingsCard.Description>
                                        <TextBlock Text="Encrypts everything sent to and from the broker." Style="{StaticResource SettingHintStyle}"/>
                                    </controls:SettingsCard.Description>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <local:InfoIcon Subject="the encrypted connection"
                                                        Info="Required by a broker that accepts encrypted clients only. A broker reached over WebSocket through a public front door is encrypted by its address rather than by this switch, so leaving it off changes nothing there. The certificate is checked against the machine's own trust store."/>
                                        <ToggleSwitch x:Name="HaTlsToggle" OnContent="On" OffContent="Off"/>
                                    </StackPanel>
                                </controls:SettingsCard>

                                <!-- The credentials sit below the addressing: they decide whether the
                                     broker accepts the session, never which door it knocks on. -->
                                <controls:SettingsCard Header="Username">
                                    <controls:SettingsCard.Description>
                                        <TextBlock Text="Leave blank for an anonymous broker." Style="{StaticResource SettingHintStyle}"/>
                                    </controls:SettingsCard.Description>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <local:InfoIcon Subject="the broker username"
                                                        Info="Part of what a found endpoint is remembered against: a broker commonly fronts a separate listener per account, so changing the user name starts the search again."/>
                                        <TextBox x:Name="HaUsernameBox" Style="{StaticResource MqttTextFieldStyle}"/>
                                    </StackPanel>
                                </controls:SettingsCard>

                                <controls:SettingsCard Header="Password">
                                    <controls:SettingsCard.Description>
                                        <TextBlock Text="Leave blank for an anonymous broker." Style="{StaticResource SettingHintStyle}"/>
                                    </controls:SettingsCard.Description>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <local:InfoIcon Subject="the broker password"
                                                        Info="Never written to the log, never published, and never part of what a found endpoint is remembered against."/>
                                        <PasswordBox x:Name="HaPasswordBox" Style="{StaticResource MqttPasswordFieldStyle}"/>
                                    </StackPanel>
                                </controls:SettingsCard>

                                <!-- The one place this page names Home Assistant, because that is the
                                     published name of the discovery convention and what the default
                                     prefix spells. Everywhere else here says broker. -->
                                <!-- Last in the section, and the only field here that is about the
                                     consumer rather than the broker. -->
                                <controls:SettingsCard Header="Discovery prefix">
                                    <controls:SettingsCard.Description>
                                        <TextBlock Text="Topic prefix the discovery messages are published under." Style="{StaticResource SettingHintStyle}"/>
                                    </controls:SettingsCard.Description>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <local:InfoIcon Subject="the discovery prefix"
                                                        Info="Entities are announced using the Home Assistant MQTT Discovery convention, an openly published spec that some MQTT consumers follow and others ignore. The prefix only needs changing for a consumer that listens elsewhere."/>
                                        <TextBox x:Name="HaPrefixBox" Style="{StaticResource MqttTextFieldStyle}"/>
                                    </StackPanel>
                                </controls:SettingsCard>

                                <!-- Apply sits at the far right, where every field above puts its own
                                     edge, so the one control that commits the section lands on the
                                     page's action edge instead of hiding at the start of a row. -->
                                <controls:SettingsCard Header="Apply these settings"
                                                       ContentAlignment="Vertical"
                                                       HorizontalContentAlignment="Stretch">
                                    <controls:SettingsCard.Description>
                                        <TextBlock Text="The fields above take effect on Apply, and the connection is remade once." Style="{StaticResource SettingHintStyle}"/>
                                    </controls:SettingsCard.Description>
                                    <StackPanel Spacing="8" Margin="0,4,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <Button x:Name="HaTestBtn" Content="Test connection" Click="OnHaTestConnectionClicked"/>
                                                <ProgressRing x:Name="HaTestProgress" Width="16" Height="16"
                                                              IsActive="False" Visibility="Collapsed"
                                                              VerticalAlignment="Center"/>
                                                <TextBlock x:Name="HaAppliedText" Text="Applied." VerticalAlignment="Center"
                                                           Style="{StaticResource SettingHintStyle}"
                                                           Visibility="Collapsed"/>
                                                <local:InfoIcon Subject="Test connection"
                                                                Info="Test connection tries the values in the fields above, including ones not yet applied. It opens its own throwaway connection and never disturbs the running one."/>
                                            </StackPanel>
                                            <Button x:Name="HaApplyBtn" Grid.Column="1" Content="Apply"
                                                    HorizontalAlignment="Right" Click="OnHaApplyClicked"/>
                                        </Grid>
                                        <!-- Names which values were tested: under the batch save model
                                             the fields and the saved settings can disagree, and a green
                                             result must not be ambiguous. -->
                                        <TextBlock x:Name="HaTestResultText" Style="{StaticResource SettingHintStyle}"
                                                   Visibility="Collapsed"/>
                                    </StackPanel>
                                </controls:SettingsCard>
                            </controls:SettingsExpander.Items>
                        </controls:SettingsExpander>

                        <!-- Last, and closed: each group maps to a Settings page, so what a toggle
                             covers needs no explaining beyond its own name, and the set is changed
                             far less often than anything above it. -->
                        <controls:SettingsExpander x:Name="MqttPublishExpander" IsExpanded="False"
                                                   Header="What to publish"
                                                   Margin="0,4,0,0">
                            <controls:SettingsExpander.Description>
                                <TextBlock Text="Which groups of entities are announced."
                                           Style="{StaticResource SettingHintStyle}"/>
                            </controls:SettingsExpander.Description>
                            <local:InfoIcon Subject="the publishing groups"
                                            Info="Each group covers the entities from the Settings page it is named after. Switching a group off withdraws its entities from the broker, so nothing is left behind as unavailable; switching it back on announces them again. Entities the hardware cannot honour are never announced, whatever these are set to."/>

                            <controls:SettingsExpander.Items>
                                <!-- One row per Settings page. Switching one off is a removal, not a
                                     pause, which is what each InfoIcon is here to say. -->
                                <controls:SettingsCard Header="Battery status">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <local:InfoIcon Subject="the battery status group"
                                                        Info="Level, charge state, power draw and the battery health figures."/>
                                        <ToggleSwitch x:Name="MqttBatteryStatusToggle" OnContent="On" OffContent="Off"
                                                      Toggled="OnMqttCategoryToggled"/>
                                    </StackPanel>
                                </controls:SettingsCard>
                                <controls:SettingsCard Header="Smart Charge">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <local:InfoIcon Subject="the Smart Charge group"
                                                        Info="The charge limit, the preset in force and the one-shot charge to full."/>
                                        <ToggleSwitch x:Name="MqttSmartChargeToggle" OnContent="On" OffContent="Off"
                                                      Toggled="OnMqttCategoryToggled"/>
                                    </StackPanel>
                                </controls:SettingsCard>
                                <controls:SettingsCard Header="Keep Awake">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <local:InfoIcon Subject="the Keep Awake group"
                                                        Info="Whether a session is holding the computer awake, and when it expires."/>
                                        <ToggleSwitch x:Name="MqttKeepAwakeToggle" OnContent="On" OffContent="Off"
                                                      Toggled="OnMqttCategoryToggled"/>
                                    </StackPanel>
                                </controls:SettingsCard>
                                <controls:SettingsCard Header="Lid close">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <local:InfoIcon Subject="the lid close group"
                                                        Info="The lid-close delay and whether the computer locks when the lid shuts."/>
                                        <ToggleSwitch x:Name="MqttLidCloseToggle" OnContent="On" OffContent="Off"
                                                      Toggled="OnMqttCategoryToggled"/>
                                    </StackPanel>
                                </controls:SettingsCard>
                                <controls:SettingsCard Header="Notifications">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <local:InfoIcon Subject="the notifications group"
                                                        Info="The battery and drain warning thresholds, and whether each is armed."/>
                                        <ToggleSwitch x:Name="MqttNotificationsToggle" OnContent="On" OffContent="Off"
                                                      Toggled="OnMqttCategoryToggled"/>
                                    </StackPanel>
                                </controls:SettingsCard>
                                <controls:SettingsCard Header="Network">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <local:InfoIcon Subject="the network group"
                                                        Info="The detected network location and the profile matching it."/>
                                        <ToggleSwitch x:Name="MqttNetworkToggle" OnContent="On" OffContent="Off"
                                                      Toggled="OnMqttCategoryToggled"/>
                                    </StackPanel>
                                </controls:SettingsCard>
                                <controls:SettingsCard Header="App diagnostics">
                                    <controls:SettingsCard.Description>
                                        <TextBlock Text="Off by default — these describe ChargeKeeper, not the battery." Style="{StaticResource SettingHintStyle}"/>
                                    </controls:SettingsCard.Description>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <local:InfoIcon Subject="the app diagnostics group"
                                                        Info="Version, uptime and the app's own health counters. Useful for watching a fleet, noise on a single machine, so a new install starts with it off."/>
                                        <ToggleSwitch x:Name="MqttAppDiagnosticsToggle" OnContent="On" OffContent="Off"
                                                      Toggled="OnMqttCategoryToggled"/>
                                    </StackPanel>
                                </controls:SettingsCard>
                            </controls:SettingsExpander.Items>
                        </controls:SettingsExpander>
                    </StackPanel>
                </StackPanel>

                <!-- The shared BrandAboutControl is hosted inline rather than behind a button that
                     opens AboutWindow, which would be a dialog on top of a dialog. The Border gives
                     it the same bordered look as the SettingsCards while keeping it distinct: the
                     studio identity inside is not this app's settings UI. -->
                <StackPanel x:Name="AboutPanel" Spacing="4" Visibility="Collapsed">
                    <TextBlock Text="About" Style="{StaticResource SectionHeaderStyle}"/>

                    <!-- The width comes from the shared control's own layout measure, applied in
                         code-behind so the two About surfaces cannot be widened apart. Left, not
                         centred: a narrower card centred in the content column would not line up
                         with its own heading or with any other section on the page. -->
                    <Border x:Name="AboutCard" HorizontalAlignment="Left"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                        <brand:BrandAboutControl x:Name="AboutInline"/>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </NavigationView>
</Window>
