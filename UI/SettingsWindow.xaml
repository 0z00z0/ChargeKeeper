<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ChargeKeeper.UI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ChargeKeeper.UI"
    xmlns:zz="using:ZeroZero.Controls.WinUI"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:brand="using:ZeroZero.Brand.WinUI"
    xmlns:mqtt="using:ZeroZero.Mqtt.WinUI"
    mc:Ignorable="d">

    <!-- Default WinUI chrome, not the popup chrome the other windows use: a popup auto-dismisses on
         focus loss, which would close this window mid-edit. -->
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <NavigationView x:Name="Nav"
                     IsSettingsVisible="False"
                     IsBackButtonVisible="Collapsed"
                     IsTabStop="False"
                     PaneDisplayMode="Left"
                     SelectionChanged="OnNavSelectionChanged">

        <!-- Lets the Mica backdrop through instead of the NavigationView painting its own lighter
             pane and top strip over it. The selection highlight is a separate brush and is
             untouched. -->
        <NavigationView.Resources>
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent"/>
            <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>

            <!-- The single source of truth for the nav icon size. The item template wraps each Icon
                 in a Viewbox bound to NavigationViewItemOnLeftIconBoxHeight, so that resource is
                 aliased to the same value rather than repeating the literal — otherwise the icons
                 are scaled back down to the 16 px default. -->
            <x:Double x:Key="NavIconSize">28</x:Double>
            <StaticResource x:Key="NavigationViewItemOnLeftIconBoxHeight" ResourceKey="NavIconSize"/>
        </NavigationView.Resources>

        <!-- Two-tone icons ship as SVG assets shown through ImageIcon: a PathIcon carries one
             colour only. -->
        <NavigationView.MenuItems>
            <NavigationViewItem Content="General"         Tag="General">
                <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/nav/general.svg" Width="{StaticResource NavIconSize}" Height="{StaticResource NavIconSize}"/></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Appearance"       Tag="Appearance">
                <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/nav/appearance.svg" Width="{StaticResource NavIconSize}" Height="{StaticResource NavIconSize}"/></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Smart Charge"     Tag="SmartCharge">
                <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/nav/smart-charge.svg" Width="{StaticResource NavIconSize}" Height="{StaticResource NavIconSize}"/></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Keep Awake"       Tag="KeepAwake">
                <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/nav/keep-awake.svg" Width="{StaticResource NavIconSize}" Height="{StaticResource NavIconSize}"/></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Lid delay"        Tag="LidClose">
                <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/nav/lid-close.svg" Width="{StaticResource NavIconSize}" Height="{StaticResource NavIconSize}"/></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Screen"            Tag="Screen">
                <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/nav/screen.svg" Width="{StaticResource NavIconSize}" Height="{StaticResource NavIconSize}"/></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Focus session"     Tag="Focus">
                <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/nav/focus.svg" Width="{StaticResource NavIconSize}" Height="{StaticResource NavIconSize}"/></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Notifications"    Tag="Notifications">
                <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/nav/notifications.svg" Width="{StaticResource NavIconSize}" Height="{StaticResource NavIconSize}"/></NavigationViewItem.Icon>
            </NavigationViewItem>
            <!-- Network profiles have no nav item of their own: a profile's only effect is which
                 preset gets applied, so the two are unusable apart. -->
            <NavigationViewItem Content="Scripts"          Tag="Scripts">
                <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/nav/scripts.svg" Width="{StaticResource NavIconSize}" Height="{StaticResource NavIconSize}"/></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="MQTT"             Tag="HomeAssistant">
                <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/nav/mqtt.svg" Width="{StaticResource NavIconSize}" Height="{StaticResource NavIconSize}"/></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="App diagnostics" Tag="AppDiagnostics">
                <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/nav/diagnostics.svg" Width="{StaticResource NavIconSize}" Height="{StaticResource NavIconSize}"/></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="About"            Tag="About">
                <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/nav/about.svg" Width="{StaticResource NavIconSize}" Height="{StaticResource NavIconSize}"/></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <!-- VersionText is filled in the constructor from the assembly version the About box also
             reads, never hard-coded. -->
        <NavigationView.PaneFooter>
            <StackPanel Margin="0,4,0,4">
                <Border Height="1" Margin="16,0,16,8"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                <StackPanel Orientation="Horizontal" Spacing="8"
                            Margin="16,4,16,12" VerticalAlignment="Center">
                    <!-- Sourced in code-behind by BrandMarkImage, which draws the mark at this
                         Width times the rasterisation scale instead of resampling one asset. -->
                    <Image x:Name="BrandMark"
                           Width="36" Height="36" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ChargeKeeper" FontSize="12"
                                   FontFamily="{StaticResource BrandFont}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="VersionText" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </NavigationView.PaneFooter>

        <ScrollViewer x:Name="ContentScroller" Padding="20,8,20,12" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="SectionHost">

                <!-- Trims the toolkit's 68 px card floor so single-line rows reserve no extra
                     height; cards carrying a description still grow past it. Scoped to this Grid so
                     it also reaches the rows built in code below. -->
                <Grid.Resources>
                    <x:Double x:Key="SettingsCardMinHeight">52</x:Double>

                    <!-- One label for the two pages that offer the same action on the same rule
                         set, so the wording cannot drift between them. -->
                    <x:String x:Key="AddNetworkProfileLabel">Add profile for this network…</x:String>
                </Grid.Resources>

                <StackPanel x:Name="GeneralPanel" Spacing="4">
                    <TextBlock Text="General" Style="{StaticResource SectionHeaderStyle}"/>

                    <controls:SettingsCard Header="Startup delay"
                                            Description="Seconds to wait after sign-in before ChargeKeeper initialises (0 = no delay).">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="StartupDelayCombo" MinWidth="140"
                                      SelectionChanged="OnStartupDelayChanged"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <!-- The Tag on each item is the enum member name, which is what the settings
                         document stores; the Content is only a label. -->
                    <controls:SettingsCard Header="Check for updates"
                                            Description="How often ChargeKeeper asks whether a newer version has been released.">
                        <ComboBox x:Name="UpdateCadenceCombo" MinWidth="180"
                                  SelectionChanged="OnUpdateCadenceChanged">
                            <ComboBoxItem Content="Every hour"      Tag="EveryHour"/>
                            <ComboBoxItem Content="Every day"       Tag="EveryDay"/>
                            <ComboBoxItem Content="Only at startup" Tag="AtStartupOnly"/>
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Install updates automatically"
                                            Description="Installs a newer version without asking once the computer has been idle ten minutes. ChargeKeeper closes while Setup runs.">
                        <ToggleSwitch x:Name="AutomaticInstallToggle" OnContent="On" OffContent="Off"
                                      Toggled="OnAutomaticInstallToggled"/>
                    </controls:SettingsCard>
                </StackPanel>

                <StackPanel x:Name="SmartChargePanel" Spacing="4" Visibility="Collapsed">
                    <TextBlock Text="Smart Charge" Style="{StaticResource SectionHeaderStyle}"/>

                    <!-- Shown alone when no vendor answered: there is nothing to set and nothing to
                         read back. -->
                    <TextBlock x:Name="NoThresholdInterfaceText"
                               Text="This computer has no charge-limit interface ChargeKeeper supports, so there is nothing to configure here."
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="Collapsed"
                               Margin="0,0,0,12"/>

                    <!-- Replaces everything below on hardware with no numeric threshold. Presets
                         and network profiles are only start and stop percentages, so there every
                         preset would collapse to the same on/off. The text is set in code-behind
                         because the cap figure comes from the vendor. -->
                    <StackPanel x:Name="FixedModeSettings" Spacing="4" Visibility="Collapsed">
                        <zz:SettingsSectionHeader Heading="Charge limit"/>

                        <!-- Built in code-behind from the vendor's modes, so the firmware owns the
                             option list and its order. A radio group rather than a toggle: a
                             three-state vendor has a middle mode with no on/off equivalent. -->
                        <RadioButtons x:Name="ChargeModeRadios"
                                      SelectionChanged="OnChargeModeSelectionChanged"
                                      Margin="0,0,0,8"/>

                        <TextBlock x:Name="FixedModeText"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,0,12"/>
                    </StackPanel>

                    <!-- Grouped so both hide together on fixed-mode hardware, where neither can be
                         expressed. -->
                    <StackPanel x:Name="NumericThresholdSettings" Spacing="4">
                    <zz:SettingsSectionHeader Heading="Presets"/>
                    <StackPanel x:Name="PresetsListPanel" Spacing="4"/>
                    <Button x:Name="AddPresetBtn" Content="Add preset" Click="OnAddPreset" Margin="0,4,0,12"/>

                    <zz:SettingsSectionHeader Heading="Network profiles"/>

                    <controls:SettingsCard Header="Enable network profiles"
                                            Description="Applies a preset automatically when the detected network location changes.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <zz:InfoIcon Subject="network profiles"
                                            Info="Matches by the adapter's MAC address and IP subnet, not by Wi-Fi network name or a VPN above it."/>
                            <ToggleSwitch x:Name="NetworkEnabledToggle" OnContent="On" OffContent="Off" Toggled="OnNetworkEnabledToggled"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <local:CurrentNetworkCard x:Name="SmartChargeCurrentNetwork"/>

                    <StackPanel x:Name="NetworkRulesListPanel" Spacing="4"/>
                    <Button x:Name="AddNetworkRuleBtn" Content="{StaticResource AddNetworkProfileLabel}"
                            Click="OnAddNetworkRule" Margin="0,4,0,12"/>

                    <controls:SettingsCard Header="Unknown-network preset"
                                            Description="Preset used when the current network matches none of the profiles above.">
                        <ComboBox x:Name="UnknownPresetCombo" MinWidth="200" SelectionChanged="OnUnknownPresetChanged"/>
                    </controls:SettingsCard>
                    </StackPanel>
                </StackPanel>

                <!-- No time or duration picker anywhere on this page: every span is typed and
                     parsed by KeepAwakeInputParser, and that fast entry is the feature. -->

                <StackPanel x:Name="KeepAwakePanel" Spacing="4" Visibility="Collapsed">
                    <TextBlock Text="Keep Awake" Style="{StaticResource SectionHeaderStyle}"/>

                    <controls:SettingsCard Header="Keep this computer awake"
                                            Description="Stops Windows sleeping while a session runs."
                                            ContentAlignment="Vertical"
                                            HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="8" Margin="0,4,0,4">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <ToggleSwitch x:Name="KeepAwakeToggle" OnContent="On" OffContent="Off" Toggled="OnKeepAwakeToggled"/>
                                <TextBlock x:Name="KeepAwakeRemainingText" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <zz:InfoIcon Subject="keeping this computer awake"
                                                Info="Ends by itself; not restored after a restart. It also holds off any lid-close sleep until it ends."/>
                            </StackPanel>

                            <!-- What a session does beyond its own clock: its effect on the lid, and
                                 the Windows rule the release hands back to. Both are live readings,
                                 so they are set in code rather than written here. -->
                            <TextBlock x:Name="KeepAwakeAfterText"
                                       FontSize="11" TextWrapping="Wrap"
                                       Visibility="Collapsed"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <!-- The dashboard's chip row, with room here for the full wording.
                                 Built in code from KeepAwakePresets. -->
                            <StackPanel x:Name="KeepAwakeChipsPanel" Orientation="Horizontal" Spacing="8"/>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="KeepAwakeCustomBox" MinWidth="180"
                                         PlaceholderText="Custom — 3h, 90m or 17:00"/>
                                <Button x:Name="KeepAwakeCustomStartBtn" Content="Start" Click="OnKeepAwakeCustomStart"/>
                            </StackPanel>
                            <TextBlock x:Name="KeepAwakeCustomEchoText" FontSize="11" Opacity="0.7"/>
                            <TextBlock x:Name="KeepAwakeCustomErrorText" FontSize="11"
                                       TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Keep the display on too"
                                            Description="Also holds the display on while a keep-awake session runs.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <zz:InfoIcon Subject="keeping the display on"
                                            Info="Off by default. Costs battery, so the dashboard badge turns amber while running on battery."/>
                            <ToggleSwitch x:Name="KeepAwakeDisplayToggle" OnContent="On" OffContent="Off" Toggled="OnKeepAwakeDisplayToggled"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <zz:SettingsSectionHeader Heading="Presets" InfoSubject="keep-awake presets"
                                                 Info="“Expires” takes a duration (3h, 90m, 1h30) or a clock time (17:00). The tray uses the first preset."/>
                    <StackPanel x:Name="KeepAwakePresetsListPanel" Spacing="4"/>
                    <Button x:Name="AddKeepAwakePresetBtn" Content="Add preset" Click="OnAddKeepAwakePreset" Margin="0,4,0,12"/>

                    <!-- The keep-awake facet of the same rules the Smart Charge page edits. It is
                         repeated here because that page's rows sit inside NumericThresholdSettings,
                         which collapses entirely on fixed-mode hardware where keep-awake-per-network
                         still has to work. -->
                    <zz:SettingsSectionHeader Heading="Networks" InfoSubject="keep-awake networks"
                                                 Info="The hold runs from arrival at a network to leaving it. Needs the Smart Charge network profiles on."/>

                    <!-- The same setting the Smart Charge page carries. It is repeated here because
                         it decides whether these rules act at all, and that page's copy is out of
                         reach on fixed-mode hardware. -->
                    <controls:SettingsCard Header="Enable network profiles"
                                            Description="Profiles act only while this is on.">
                        <ToggleSwitch x:Name="KeepAwakeNetworkEnabledToggle" OnContent="On" OffContent="Off"
                                      Toggled="OnNetworkEnabledToggled"/>
                    </controls:SettingsCard>

                    <local:CurrentNetworkCard x:Name="KeepAwakeCurrentNetwork"/>

                    <StackPanel x:Name="KeepAwakeNetworkRulesListPanel" Spacing="4"/>
                    <Button x:Name="AddKeepAwakeNetworkRuleBtn" Content="{StaticResource AddNetworkProfileLabel}"
                            Click="OnAddKeepAwakeNetworkRule" Margin="0,4,0,12"/>
                </StackPanel>
                <!-- The only setting in the app that changes a Windows setting outside it, so the
                     wording is blunt about which setting and how it comes back. -->
                <StackPanel x:Name="LidClosePanel" Spacing="4" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                        <TextBlock Text="Lid delay" Style="{StaticResource SectionHeaderStyle}"
                                   Margin="0" VerticalAlignment="Center"/>
                        <zz:InfoIcon Subject="lid delay"
                                        Info="Sets the Windows lid-close action to “Do nothing”, and its battery sleep timeout to Never while a wait runs."/>
                    </StackPanel>

                    <!-- No section heading above the master switch: it governs everything on the
                         page, and a heading over it would claim it belongs to one part. -->
                    <controls:SettingsCard Header="Handle the lid closing"
                                            Description="ChargeKeeper decides when the computer sleeps after the lid closes, instead of Windows. A keep-awake session holds the sleep off.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <zz:InfoIcon Subject="lid handling"
                                            Info="Sleeps on whichever condition below is reached first, or at once if neither is on."/>
                            <ToggleSwitch x:Name="LidDelayToggle" OnContent="On" OffContent="Off" Toggled="OnLidDelayToggled"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <!-- What this machine's sleep type does to the promise above. A live reading, so
                         it is set in code rather than written here, and shown on nothing but a
                         Modern Standby machine. -->
                    <TextBlock x:Name="LidStandbyCaveatText"
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="Collapsed"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <!-- The rows that hold whichever kind of wait is running, so they sit above both
                         preset groups rather than beside one of them. Disabled rather than hidden
                         while lid handling is off: with it off there is no lid close to act on. -->
                    <controls:SettingsCard Header="Switch off once the computer has slept"
                                            Description="Turns lid handling off again after one lid close ends in sleep.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <zz:InfoIcon Subject="switching lid handling off after it has held"
                                            Info="Only a lid close that ends in sleep counts. Opening the lid first leaves lid handling on."/>
                            <ToggleSwitch x:Name="LidOffAfterSleepToggle" OnContent="On" OffContent="Off" Toggled="OnLidOffAfterSleepToggled"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <!-- On by default: handling the lid parks the Windows lid-close action on "do
                         nothing", which also removes the sign-in prompt a lid close normally leads
                         to. This puts it back. -->
                    <controls:SettingsCard Header="Lock the computer when the lid closes"
                                            Description="Locks the computer as soon as the lid closes.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <zz:InfoIcon Subject="locking at lid close"
                                            Info="Handling the lid removes the normal sign-in prompt at lid close; this restores it."/>
                            <ToggleSwitch x:Name="LidLockToggle" OnContent="On" OffContent="Off" Toggled="OnLidLockToggled"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <zz:SettingsSectionHeader Heading="Sleep after a time" InfoSubject="the sleep delay"
                                                 Info="Sleeps after this delay once the lid is shut. With a battery target too, whichever arrives first wins."/>

                    <controls:SettingsCard Header="Sleep once a delay has run out"
                                            Description="Sleeps when the delay below runs out, unless the battery target is reached first.">
                        <ToggleSwitch x:Name="LidDelayTimeToggle" OnContent="On" OffContent="Off" Toggled="OnLidDelayTimeToggled"/>
                    </controls:SettingsCard>

                    <StackPanel x:Name="LidDelayPresetsListPanel" Spacing="4"/>
                    <Button x:Name="AddLidDelayPresetBtn" Content="Add delay"
                            Click="OnAddLidDelayPreset" Margin="0,4,0,12"/>

                    <zz:SettingsSectionHeader Heading="Sleep at a battery level" InfoSubject="the battery target"
                                                 Info="Charging pauses the countdown; it resumes once unplugged. With a delay set too, whichever arrives first wins."/>

                    <controls:SettingsCard Header="Sleep once the battery reaches a level"
                                            Description="Sleeps when the battery reaches the target below, unless the delay runs out first.">
                        <ToggleSwitch x:Name="LidDischargeToggle" OnContent="On" OffContent="Off" Toggled="OnLidDischargeToggled"/>
                    </controls:SettingsCard>

                    <StackPanel x:Name="LidDischargeTargetsListPanel" Spacing="4"/>
                    <Button x:Name="AddLidDischargeTargetBtn" Content="Add target"
                            Click="OnAddLidDischargeTarget" Margin="0,4,0,12"/>

                    <zz:SettingsSectionHeader Heading="Sleep if the computer gets hot" InfoSubject="the temperature ceiling"
                                                 Info="Crossing this sleeps the computer at once. It never shuts down, so nothing open is lost."/>

                    <controls:SettingsCard x:Name="LidThermalCard"
                                            Header="Sleep if the computer reaches a temperature"
                                            Description="Ends the wait early and sleeps the computer, ahead of the delay and the battery target.">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ComboBox x:Name="LidThermalCeilingCombo" MinWidth="110"
                                      SelectionChanged="OnLidThermalCeilingChanged"/>
                            <ToggleSwitch x:Name="LidThermalToggle" OnContent="On" OffContent="Off"
                                          Toggled="OnLidThermalToggled"/>
                        </StackPanel>
                    </controls:SettingsCard>
                </StackPanel>

                <StackPanel x:Name="ScreenPanel" Spacing="4" Visibility="Collapsed">
                    <TextBlock Text="Screen" Style="{StaticResource SectionHeaderStyle}"/>

                    <!-- The unsupported line and the two controls swap: a machine whose only screen
                         is an external monitor gets the explanation instead of a slider that would
                         reach nothing. -->
                    <controls:SettingsCard x:Name="ScreenUnsupportedCard"
                                            Header="Brightness"
                                            Description="No display here accepts a brightness from Windows. An external monitor is set from its own buttons."
                                            Visibility="Collapsed"/>

                    <controls:SettingsCard x:Name="ScreenBrightnessCard"
                                            Header="Brightness"
                                            Description="Dims the built-in screen without sleeping the computer.">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <zz:InfoIcon Subject="brightness"
                                            Info="Reaches the built-in screen only. Restore puts back the level in force before the first change."/>
                            <TextBlock x:Name="ScreenBrightnessValue" VerticalAlignment="Center" MinWidth="44"/>
                            <Slider x:Name="ScreenBrightnessSlider" Width="200" Minimum="0" Maximum="100"
                                    StepFrequency="1" ValueChanged="OnScreenBrightnessChanged"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="ScreenRestoreCard"
                                            Header="Restore brightness"
                                            Description="Puts back the level the screen was on before the first change.">
                        <Button x:Name="ScreenRestoreBtn" Content="Restore" Click="OnScreenRestore"/>
                    </controls:SettingsCard>
                </StackPanel>

                <StackPanel x:Name="FocusPanel" Spacing="4" Visibility="Collapsed">
                    <TextBlock Text="Focus session" Style="{StaticResource SectionHeaderStyle}"/>

                    <!-- Status, and nothing to press. A person at the keyboard cannot end a session:
                         that is the feature's central property, not an omission to be filled in. -->
                    <controls:SettingsCard Header="Status"
                                            Description="A session runs for the length it was given. Nothing on this computer ends one early.">
                        <TextBlock x:Name="FocusStatusValue" VerticalAlignment="Center"
                                    MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Length"
                                            Description="How long the next session runs. Changing this while one runs changes the next one only.">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <ComboBox x:Name="FocusMinutesCombo" MinWidth="110"
                                      SelectionChanged="OnFocusMinutesChanged"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <!-- One switch per lever, settable here or from Home Assistant — both write
                         through the same action, so the two stay one value. Locked for the length of
                         a session once it starts: a lever turned off part-way through would leave its
                         record parked with nothing owning it. -->
                    <controls:SettingsCard Header="Blocks the network"
                                            Description="Blocks outbound and unsolicited inbound traffic on every firewall profile while a session runs, aside from two Home Assistant exceptions.">
                        <ToggleSwitch x:Name="FocusBlocksNetworkToggle" OnContent="" OffContent=""
                                      MinWidth="0" Toggled="OnFocusBlocksNetworkToggled"/>
                    </controls:SettingsCard>

                    <!-- The allow-list on the network lever. Empty is the whole of what an
                         installation that has chosen no program carries, so nothing changes for
                         one that never opens this. -->
                    <controls:SettingsCard Header="Programs that keep the network"
                                            Description="These reach the network while a session runs. Everything else stays blocked.">
                        <Button x:Name="FocusAllowProgramBtn" Content="Allow a program"
                                Click="OnFocusAllowProgram"/>
                    </controls:SettingsCard>
                    <StackPanel x:Name="FocusAllowedProgramsPanel" Spacing="4"/>

                    <controls:SettingsCard Header="Dims the screen"
                                            Description="Lowers the built-in screen's brightness for the length of a session and puts it back afterwards.">
                        <ToggleSwitch x:Name="FocusDimsScreenToggle" OnContent="" OffContent=""
                                      MinWidth="0" Toggled="OnFocusDimsScreenToggled"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Covers the screen"
                                            Description="Puts a black window over every display for the length of a session.">
                        <ToggleSwitch x:Name="FocusCoversScreenToggle" OnContent="" OffContent=""
                                      MinWidth="0" Toggled="OnFocusCoversScreenToggled"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Blocks the mouse and keyboard"
                                            Description="Turns the mouse and keyboard off for the length of a session. The machine answers nothing, this application included.">
                        <ToggleSwitch x:Name="FocusBlocksInputToggle" OnContent="" OffContent=""
                                      MinWidth="0" Toggled="OnFocusBlocksInputToggled"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Start a session from the dashboard"
                                            Description="Adds a Start button to the dashboard's focus row. It starts a session; ending one still needs Home Assistant.">
                        <ToggleSwitch x:Name="FocusStartFromDashboardToggle" OnContent="" OffContent=""
                                      MinWidth="0" Toggled="OnFocusStartFromDashboardToggled"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Recent sessions"
                                            Description="The last few sessions, with how long each ran and how it ended."
                                            ContentAlignment="Vertical"
                                            HorizontalContentAlignment="Stretch">
                        <StackPanel x:Name="FocusRecentPanel" Spacing="4"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="If you are stuck"
                                            ContentAlignment="Vertical"
                                            HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="6">
                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       Text="End it early from Home Assistant: send the request, wait five minutes, send it again within ten seconds."/>
                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       Text="Lift the network block: in Windows Defender Firewall with Advanced Security, delete the two rules named &quot;ChargeKeeper focus session: broker&quot; and &quot;ChargeKeeper focus session: name resolution&quot;."/>
                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       Text="Each allowed program has a numbered rule beside those two. Delete those as well."/>
                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       Text="Turn the screen brightness back up by hand."/>
                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       Text="Exit ChargeKeeper from the tray icon to take the black cover down. The session keeps running."/>
                        </StackPanel>
                    </controls:SettingsCard>
                </StackPanel>

                <StackPanel x:Name="NotificationsPanel" Spacing="4" Visibility="Collapsed">
                    <TextBlock Text="Notifications" Style="{StaticResource SectionHeaderStyle}"/>

                    <!-- One sound for every row below. The choices are filled in code from
                         NotificationSounds.Choices, which also holds their order. -->
                    <controls:SettingsCard Header="Sound"
                                            Description="Played with every notification. Low battery falls, High battery rises.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="NotificationSoundCombo" MinWidth="160"
                                      SelectionChanged="OnNotificationSoundChanged"/>
                            <Button x:Name="NotificationSoundPreviewButton"
                                    Click="OnNotificationSoundPreviewClicked"
                                    ToolTipService.ToolTip="Play the sound"
                                    AutomationProperties.Name="Play the sound">
                                <FontIcon Glyph="&#xE768;" FontSize="14"/>
                            </Button>
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Low battery warning"
                                            Description="Notify when the battery drops to this level while discharging.">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ComboBox x:Name="LowBattPctCombo" MinWidth="110"
                                      SelectionChanged="OnLowBattPctChanged"/>
                            <ToggleSwitch x:Name="LowBattEnabledToggle" OnContent="On" OffContent="Off" Toggled="OnLowBattEnabledToggled"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="High battery warning"
                                            Description="Notify when the battery rises to this level.">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <zz:InfoIcon Subject="the high battery warning"
                                            Info="Fires once on the way up, then stays silent until the level drops back below."/>
                            <ComboBox x:Name="HighBattPctCombo" MinWidth="110"
                                      SelectionChanged="OnHighBattPctChanged"/>
                            <ToggleSwitch x:Name="HighBattEnabledToggle" OnContent="On" OffContent="Off" Toggled="OnHighBattEnabledToggled"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Overnight-drain warning"
                                            Description="Notify when the battery drains faster than this rate while the computer is off.">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ComboBox x:Name="DrainPctPerHourCombo" MinWidth="110"
                                      SelectionChanged="OnDrainPctPerHourChanged"/>
                            <ToggleSwitch x:Name="DrainEnabledToggle" OnContent="On" OffContent="Off" Toggled="OnDrainEnabledToggled"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <!-- Each Tag names the NotificationKind its switch governs. -->
                    <controls:SettingsCard Header="Battery charged"
                                            Description="Notify when charging stops, at the Smart Charge limit or at full.">
                        <ToggleSwitch x:Name="ChargeCompleteToggle" Tag="ChargeComplete" OnContent="On" OffContent="Off" Toggled="OnNotificationSwitchToggled"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Charging"
                                            Description="Notify when the battery starts charging on AC power.">
                        <ToggleSwitch x:Name="ChargingStartedToggle" Tag="ChargingStarted" OnContent="On" OffContent="Off" Toggled="OnNotificationSwitchToggled"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Slept early to cool down"
                                            Description="Notify at the next wake when the computer slept early because it got too hot with the lid shut.">
                        <ToggleSwitch x:Name="SleptWhileHotToggle" Tag="SleptWhileHot" OnContent="On" OffContent="Off" Toggled="OnNotificationSwitchToggled"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Settings not saved"
                                            Description="Notify when the settings file cannot be written, so a change would be gone at the next start.">
                        <ToggleSwitch x:Name="SettingsNotSavedToggle" Tag="SettingsNotSaved" OnContent="On" OffContent="Off" Toggled="OnNotificationSwitchToggled"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Script failed"
                                            Description="Notify the first time a script fails, and again only after one of its runs has succeeded.">
                        <ToggleSwitch x:Name="ScriptFailedToggle" Tag="ScriptFailed" OnContent="On" OffContent="Off" Toggled="OnNotificationSwitchToggled"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Something keeping this computer awake"
                                            Description="Notify once another program has held the computer awake for this long. This application's own holds are never counted.">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ComboBox x:Name="AwakeHoldHoursCombo" MinWidth="110"
                                      SelectionChanged="OnAwakeHoldHoursChanged"/>
                            <ToggleSwitch x:Name="AwakeHoldToggle" Tag="AwakeHold" OnContent="On" OffContent="Off" Toggled="OnNotificationSwitchToggled"/>
                        </StackPanel>
                    </controls:SettingsCard>
                </StackPanel>

                <!-- The rows are built in code: a script's editor is a name, an event and a box for
                     the script, and a list of those cannot be written out in markup. The two lines
                     under the heading are the page's standing facts, not settings, so they are
                     markup. -->
                <StackPanel x:Name="ScriptsPanel" Spacing="4" Visibility="Collapsed">
                    <TextBlock Text="Scripts" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock Text="Runs a named PowerShell script when the charger connects or disconnects, or the lid opens or closes."
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <!-- Not visible from the rows, so a program started from a script would be
                         running with rights nobody chose. -->
                    <TextBlock Text="Scripts run with administrator rights, and so does anything they start."
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,4,0,8"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <StackPanel x:Name="ScriptsListPanel" Spacing="4"/>
                    <Button x:Name="AddScriptBtn" Content="Add script"
                            Click="OnAddScript" Margin="0,4,0,12"/>
                </StackPanel>

                <!-- Five sections in the order the questions arise: whether to publish at all, what
                     the connection is doing, which device this is, how it is reached, and what goes
                     out. The last two are collapsed, because both are set once and then left. -->
                <StackPanel x:Name="HomeAssistantPanel" Spacing="12" Visibility="Collapsed">

                    <!-- The page title. Everything below it is the shared module's panel: the broker
                         block, the status rows, the device identity and one row per publish group are
                         identical for every application that publishes over MQTT, so none of them is
                         ChargeKeeper's to draw. What IS ChargeKeeper's arrives through MqttPanelSetup
                         in the code-behind — the heading, the one line saying what this app publishes,
                         and the group vocabulary. The panel scrolls nothing itself and lives inside
                         the page's own ScrollViewer.

                         Home Assistant is named once, under Discovery prefix inside the panel,
                         because that is the published name of the convention and not the name of a
                         dependency. -->
                    <TextBlock Text="MQTT" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock Text="Publishes ChargeKeeper's battery, charge and settings surface to an MQTT broker, announced as one device with its entities."
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <!-- No face set here. Every panel text style names the module's own font key,
                         so an inherited FontFamily reaches nothing. The face arrives because that key
                         defaults to ContentControlThemeFontFamily, which App.xaml overrides. -->
                    <mqtt:MqttSettingsPanel x:Name="MqttPanel"/>
                </StackPanel>

                <!-- The shared BrandAboutControl is hosted inline rather than behind a button that
                     opens AboutWindow, which would be a dialog on top of a dialog. The Border gives
                     it the same bordered look as the SettingsCards while keeping it distinct: the
                     studio identity inside is not this app's settings UI. -->
                <StackPanel x:Name="AppearancePanel" Spacing="4" Visibility="Collapsed">
                    <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderStyle}"/>

                    <!-- Grouped for the page only: every control here keeps its own section in
                         settings.json, whose spelling is load-bearing, so moving a card between these
                         headings or from General changes nothing in the file. -->
                    <zz:SettingsSectionHeader Heading="Tray"/>

                    <controls:SettingsCard Header="Tray icon style"
                                            Description="How the battery level is drawn in the system tray.">
                        <!-- Item order IS the TrayIconMode order: the load and save cast between the
                             enum and SelectedIndex by position. Append, never insert. -->
                        <ComboBox x:Name="IconModeCombo" MinWidth="160" SelectionChanged="OnIconModeChanged">
                            <ComboBoxItem Content="Arc gauge"/>
                            <ComboBoxItem Content="Numeric %"/>
                            <!-- Named for what appears in the notification area, not for where the
                                 drawing comes from. The persisted value is still TrayIconMode
                                 .BrandMark; only the label reads differently. -->
                            <ComboBoxItem Content="Battery fill"/>
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="DigitStyleCard"
                                            Header="Tray digits"
                                            Description="What the tray draws as a number, and how.">
                        <!-- Item order IS the TrayDigitStyle order, as the style combo above:
                             the load and save cast by position. Append, never insert. Labels match
                             TrayDigitStyleLabels, which the tray menu reads. -->
                        <ComboBox x:Name="DigitStyleCombo" MinWidth="160" SelectionChanged="OnDigitStyleChanged">
                            <ComboBoxItem Content="Standard"/>
                            <ComboBoxItem Content="Cropped"/>
                            <!-- The persisted value is still TrayDigitStyle.ClockCells; only the
                                 label reads differently. -->
                            <ComboBoxItem Content="Staggered"/>
                            <!-- The one entry that changes the value drawn rather than the face:
                                 hours left, in the Standard face. -->
                            <ComboBoxItem Content="Hours left"/>
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Show icons in main tray (experimental)"
                                            Description="Keeps the tray icons on the taskbar instead of behind the overflow chevron.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ToggleSwitch x:Name="PromoteIconsToggle" OnContent="On" OffContent="Off"
                                          Toggled="OnPromoteIconsToggled"/>
                            <zz:InfoIcon Subject="Show icons in main tray"
                                            Info="No supported Windows API for this, so it may do nothing on some Windows versions."/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="PercentageIconCard"
                                            Header="Also show percentage"
                                            Description="Adds a second tray icon showing the charge level as a number.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ToggleSwitch x:Name="PercentageIconToggle" OnContent="On" OffContent="Off"
                                          Toggled="OnPercentageIconToggled"/>
                            <zz:InfoIcon Subject="Also show percentage"
                                            Info="Right-click the second icon for its own digit style. A new tray icon starts behind the overflow chevron."/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <zz:SettingsSectionHeader Heading="Dashboard"/>

                    <controls:SettingsCard Header="One line until it matters"
                                            Description="Collapse an off feature on the dashboard popup to its name, its switch and nothing else.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <zz:InfoIcon Subject="One line until it matters"
                                            Info="Only an off feature collapses, to its name, switch and an arrow to expand it."/>
                            <ToggleSwitch x:Name="OneLineUntilItMattersToggle" Toggled="OnOneLineUntilItMattersToggled"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="HideGraphInDashboardCard"
                                            Header="Hide graph in dashboard"
                                            Description="Replaces the dashboard's history graph with a button that opens it.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <zz:InfoIcon Subject="Hide graph in dashboard"
                                            Info="Leaves out the range buttons, plot and legend. The button opens the same larger graph window."/>
                            <ToggleSwitch x:Name="HideGraphInDashboardToggle" OnContent="On" OffContent="Off"
                                          Toggled="OnHideGraphInDashboardToggled"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <zz:SettingsSectionHeader Heading="Graph"/>

                    <controls:SettingsCard Header="History graph range"
                                            Description="Default time span shown in the battery history graph.">
                        <ComboBox x:Name="GraphScaleCombo" MinWidth="160" SelectionChanged="OnGraphScaleChanged">
                            <ComboBoxItem Content="15 minutes"/>
                            <ComboBoxItem Content="1 hour"/>
                            <ComboBoxItem Content="6 hours"/>
                            <ComboBoxItem Content="12 hours"/>
                            <ComboBoxItem Content="1 day"/>
                            <ComboBoxItem Content="1 week"/>
                            <ComboBoxItem Content="14 days"/>
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="History graph line colour"
                                            Description="How the charge line in the battery history graph is coloured.">
                        <!-- Each item's Tag names its GraphLineColouring member and the load and save
                             parse it, so item order carries no meaning here and inserting one is safe.
                             The two combos above are coupled by position instead; leave them be. -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="GraphLineColouringCombo" MinWidth="180"
                                      SelectionChanged="OnGraphLineColouringChanged">
                                <ComboBoxItem Content="One colour"         Tag="OneColour"/>
                                <ComboBoxItem Content="By level"           Tag="ByLevel"/>
                                <ComboBoxItem Content="By level and state" Tag="ByLevelAndState"/>
                            </ComboBox>
                            <zz:InfoIcon Subject="colouring by level and state"
                                            Info="By level uses the on-battery scale only. By level and state also reflects charging and mains."/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="History graph shading"
                                            Description="Draws the accent fade under the charge line. Independent of the line colour setting above.">
                        <ToggleSwitch x:Name="GraphShadingToggle" OnContent="On" OffContent="Off"
                                      Toggled="OnGraphShadingToggled"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Downtime gap threshold"
                                            Description="How long a gap in the samples must be before the graph shows it as a break (0 = none).">
                        <ComboBox x:Name="DowntimeGapCombo" MinWidth="140"
                                  SelectionChanged="OnDowntimeGapChanged"/>
                    </controls:SettingsCard>
                </StackPanel>

                <StackPanel x:Name="AppDiagnosticsPanel" Spacing="4" Visibility="Collapsed">
                    <TextBlock Text="App diagnostics" Style="{StaticResource SectionHeaderStyle}"/>

                    <!-- The switch and the rate sit with the graph they govern, so turning
                         measurement on and seeing what it costs is one place rather than two. -->
                    <controls:SettingsCard Header="Performance graph"
                                            Description="Record and plot what ChargeKeeper itself is using.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <zz:InfoIcon Subject="Performance graph"
                                            Info="Off: nothing runs, no cost. On: samples itself and writes performance-history.csv beside the battery history."/>
                            <ToggleSwitch x:Name="PerformanceGraphToggle" Toggled="OnPerformanceGraphToggled"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Sampling rate"
                                            Description="How often processor time is read. Memory, handles and I/O are always read once a second.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <zz:InfoIcon Subject="Sampling rate"
                                            Info="At 10, 5 or 2 Hz a single sample can spike well above real cost. Read the dashed mean instead."/>
                            <!-- Item order IS the PerformanceSampleRate order: the load and save cast
                                 between the enum and SelectedIndex by position. Append, never insert. -->
                            <ComboBox x:Name="PerformanceRateCombo" MinWidth="140"
                                      SelectionChanged="OnPerformanceRateChanged"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <!-- Collapsed until ShowSection shows its page, so it never repaints behind
                         another page. -->
                    <local:PerformanceGraphControl x:Name="PerformanceGraph" Margin="0,8,0,0" Visibility="Collapsed"/>

                    <zz:SettingsSectionHeader Heading="Advanced"/>
                    <!-- Vertical, as the Keep Awake page's session card: beside a row of three buttons
                         the description is squeezed into a narrow column. -->
                    <controls:SettingsCard Header="Settings file"
                                            Description="ChargeKeeper stores its configuration in settings.json."
                                            ContentAlignment="Vertical"
                                            HorizontalContentAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="OpenSettingsFolderBtn" Content="Open settings folder" Click="OnOpenSettingsFolder"/>
                            <Button x:Name="OpenSettingsFileBtn" Content="Open settings file" Click="OnOpenSettingsFile"/>
                            <Button x:Name="ReloadSettingsBtn" Content="Reload settings from file" Click="OnReloadSettings"/>
                            <zz:InfoIcon Subject="the settings file"
                                            Info="Reload reads settings.json again, picking up a manual edit or a file synced from another machine."/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Logs"
                                            Description="app.log holds activity and power, lid and sleep events.">
                        <DropDownButton x:Name="OpenLogButton" Content="Open log">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem Text="app.log" Click="OnOpenAppLogClick"/>
                                    <MenuFlyoutItem Text="performance-history.csv" Click="OnOpenPerformanceHistoryLogClick"/>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </controls:SettingsCard>
                </StackPanel>

                <StackPanel x:Name="AboutPanel" Spacing="4" Visibility="Collapsed">
                    <TextBlock Text="About" Style="{StaticResource SectionHeaderStyle}"/>

                    <!-- The width comes from the shared control's own layout measure, applied in
                         code-behind so the two About surfaces cannot be widened apart. Left, not
                         centred: a narrower card centred in the content column would not line up
                         with its own heading or with any other section on the page. -->
                    <Border x:Name="AboutCard" HorizontalAlignment="Left"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                        <brand:BrandAboutControl x:Name="AboutInline"/>
                    </Border>

                    <!-- What's new is the card's own row button; under the card, on its own, the
                         same Check for updates button the About window carries. It sits on this page
                         because the version it compares against is already here. Centred under the
                         card: the row is given the card's own width in code-behind and left-anchored
                         to start at the same edge, so centring inside it lines up with the card
                         rather than with the wider content column. -->
                    <Grid x:Name="CheckForUpdatesRow" HorizontalAlignment="Left" Margin="0,12,0,0">
                        <brand:BrandBracketButton x:Name="CheckForUpdatesButton" HorizontalAlignment="Center"/>
                    </Grid>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </NavigationView>
</Window>
