<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ChargeKeeper.UI.ProgramPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ChargeKeeper.UI"
    xmlns:services="using:ChargeKeeper.Services"
    mc:Ignorable="d">

    <!-- The same chrome as the other frameless boxes reached from a window rather than the tray. -->
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid KeyboardAcceleratorPlacementMode="Hidden" Padding="20" RowSpacing="12">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked"/>
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Allow a program"
                   FontSize="15" FontWeight="SemiBold"
                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

        <TextBox Grid.Row="1" x:Name="QueryBox"
                 PlaceholderText="Type to narrow the list"
                 AutomationProperties.Name="Search programs"
                 TextChanged="OnQueryChanged"
                 KeyDown="OnQueryKeyDown"/>

        <!-- The list is built afresh every time this window opens, so a program started since the
             last open is on it. -->
        <Grid Grid.Row="2">
            <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" Spacing="10"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressRing IsActive="True" Width="18" Height="18"/>
                <TextBlock Text="Reading the list of programs…" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <TextBlock x:Name="EmptyText" Visibility="Collapsed"
                       Text="Nothing matches. Choose a file instead."
                       FontSize="12" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <ListView x:Name="ProgramList" Visibility="Collapsed"
                      SelectionMode="Single"
                      AutomationProperties.Name="Programs"
                      DoubleTapped="OnListDoubleTapped"
                      SelectionChanged="OnListSelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="services:ProgramChoice">
                        <Grid Margin="0,2" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Bind Name}" FontSize="13"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{x:Bind Path}" FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind OpenMark}" FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="NoteText"
                   FontSize="11" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Store apps are left out: a firewall rule cannot name one by its file."/>

        <Grid Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BrowseButton"
                    Content="Choose a file…"
                    ToolTipService.ToolTip="For a program the list does not hold"
                    Click="OnBrowseButton"/>
            <Button Grid.Column="2" x:Name="CancelButton"
                    Content="Cancel"
                    Click="OnCancelButton"/>
            <Button Grid.Column="3" x:Name="AddButton"
                    Content="Allow"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnAddButton"/>
        </Grid>
    </Grid>
</Window>
