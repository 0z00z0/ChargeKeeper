<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ChargeKeeper.UI.BatteryHistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ChargeKeeper.UI"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <!-- The same graph control at full size. ShowExpandButton is off: this window is where
         expanding leads. -->
    <Grid Padding="20,16,20,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- stats -->
            <RowDefinition Height="*"/>     <!-- graph -->
            <RowDefinition Height="Auto"/>  <!-- health -->
        </Grid.RowDefinitions>

        <!-- Room here for the adapter wattage the 340 px dashboard popup cannot fit. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="28">
            <StackPanel Spacing="2">
                <TextBlock Text="POWER" Style="{StaticResource StatLabelStyle}"/>
                <TextBlock x:Name="PowerSourceText"
                           Text="—"
                           Style="{StaticResource StatValueStyle}"/>
            </StackPanel>
            <StackPanel Spacing="2">
                <TextBlock Text="REMAINING" Style="{StaticResource StatLabelStyle}"/>
                <TextBlock x:Name="TimeRemainingText"
                           Text="—"
                           Style="{StaticResource StatValueStyle}"/>
            </StackPanel>
        </StackPanel>

        <local:BatteryHistoryGraphControl x:Name="HistoryGraph" Grid.Row="1" ShowExpandButton="False"/>

        <local:BatteryHealthPanel x:Name="HealthPanel" Grid.Row="2"/>
    </Grid>
</Window>
