<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ChargeKeeper.UI.BatteryHistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ChargeKeeper.UI"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <!-- The same graph control at full size, plus the self-measurement graph as an alternative
         view. ShowExpandButton is off: this window is where expanding leads. -->
    <!-- KeyboardAcceleratorPlacementMode Hidden: WinUI otherwise shows the accelerator's key as a
         tooltip ("Esc") over every part of the window without a tooltip of its own. -->
    <Grid x:Name="RootGrid" Padding="20,16,20,20" RowSpacing="12" KeyboardAcceleratorPlacementMode="Hidden">
        <!-- Escape dismisses exactly as clicking away does. On the root so it fires wherever focus
             sits; nothing in this window wants the key for itself. -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked"/>
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- stats -->
            <RowDefinition Height="Auto"/>  <!-- graph display selector -->
            <RowDefinition Height="*"/>     <!-- graph -->
            <RowDefinition Height="Auto"/>  <!-- health -->
            <RowDefinition Height="Auto"/>  <!-- what the last sleeps cost -->
        </Grid.RowDefinitions>

        <!-- Room here for the adapter wattage the 340 px dashboard popup cannot fit. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="28">
            <StackPanel Spacing="2">
                <TextBlock Text="POWER" Style="{StaticResource StatLabelStyle}"/>
                <TextBlock x:Name="PowerSourceText"
                           Text="—"
                           Style="{StaticResource StatValueStyle}"/>
            </StackPanel>
            <StackPanel x:Name="TimeRemainingPanel" Spacing="2">
                <TextBlock Text="REMAINING" Style="{StaticResource StatLabelStyle}"/>
                <TextBlock x:Name="TimeRemainingText"
                           Text="—"
                           Style="{StaticResource StatValueStyle}"/>
            </StackPanel>
        </StackPanel>

        <!-- Battery is the graph that has always shown here; System is the self-measurement graph.
             Only one of the two controls below is visible at a time — Visibility is set in
             code-behind from the persisted GraphDisplay setting, never both together. -->
        <StackPanel Grid.Row="1"
                    x:Name="GraphDisplayPanel"
                    Orientation="Horizontal"
                    Spacing="4">
            <Button x:Name="BatteryDisplayButton" Content="Battery" Tag="Battery" Click="OnGraphDisplayButtonClick" Style="{StaticResource TimeScaleButtonStyle}"
                    ToolTipService.ToolTip="Show battery level, charge limit and power over time"/>
            <Button x:Name="SystemDisplayButton"  Content="System"  Tag="System"  Click="OnGraphDisplayButtonClick" Style="{StaticResource TimeScaleButtonStyle}"
                    ToolTipService.ToolTip="Show how much processor time and memory ChargeKeeper itself uses"/>
        </StackPanel>

        <local:BatteryHistoryGraphControl x:Name="HistoryGraph" Grid.Row="2" ShowExpandButton="False"/>

        <!-- The self-measurement graph, hidden by default so an existing installation's pop-out
             looks unchanged until System is chosen. -->
        <local:PerformanceGraphControl x:Name="PerformanceGraph" Grid.Row="2" Visibility="Collapsed"/>

        <local:BatteryHealthPanel x:Name="HealthPanel" Grid.Row="3"/>

        <!-- Beside the drain the graph shows: what each recent modern-standby session cost, from
             Windows' own record of it. Filled in code; collapsed when there is nothing to show. -->
        <StackPanel Grid.Row="4" x:Name="StandbySessionsPanel" Spacing="2" Visibility="Collapsed">
            <TextBlock Text="RECENT SLEEPS" Style="{StaticResource StatLabelStyle}"/>
            <TextBlock x:Name="StandbySessionsText" TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
    </Grid>
</Window>
