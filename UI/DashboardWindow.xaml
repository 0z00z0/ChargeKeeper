<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ChargeKeeper.UI.DashboardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ChargeKeeper.UI"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <!-- No fixed size: the window is measured from this grid, so rows can appear and disappear
         without hard-coded height constants. Bottom padding matches the left/right 20 rather than
         the tighter 12 it used to carry: the last badge's chip row sat too close to the window edge
         at 12, independent of width. -->
    <Grid x:Name="RootGrid" Padding="20,16,20,20">
        <!-- Escape dismisses exactly as clicking away does. On the root so it fires wherever focus
             sits; nothing in this window wants the key for itself. -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked"/>
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- header -->
            <RowDefinition Height="Auto"/>  <!-- gauge and stats -->
            <RowDefinition Height="Auto"/>  <!-- history graph -->
            <RowDefinition Height="Auto"/>  <!-- separator -->
            <RowDefinition Height="Auto"/>  <!-- status badges -->
        </Grid.RowDefinitions>

        <!-- A Grid, not a StackPanel: only a Grid can push the settings button to the far edge. -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                <!-- Sourced in code-behind by BrandMarkImage, which draws the mark at this Width
                     times the rasterisation scale instead of resampling one asset. -->
                <Image x:Name="BrandMark"
                       Width="18" Height="18" VerticalAlignment="Center"/>
                <TextBlock Text="ChargeKeeper"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            </StackPanel>

            <!-- Set inline rather than through TimeScaleButtonStyle, which lives in
                 BatteryHistoryGraphControl's resources and is not in scope here. -->
            <Button Grid.Column="1"
                    x:Name="SettingsButton"
                    Width="28" Height="28"
                    Padding="0"
                    CornerRadius="4"
                    BorderThickness="0"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Settings"
                    AutomationProperties.Name="Settings"
                    Click="OnSettingsButton">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="14"/>
            </Button>
        </Grid>

        <!-- Gauge left, stats filling the remaining width. -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Width="100" Height="100" Margin="0,0,16,0">
                <!-- Track. -->
                <Canvas Width="100" Height="100">
                    <Path x:Name="GaugeTrack"
                          Stroke="{ThemeResource ControlStrokeColorDefaultBrush}"
                          StrokeThickness="10"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Canvas.Left="0" Canvas.Top="0"/>
                    <Path x:Name="GaugeFill"
                          StrokeThickness="10"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Canvas.Left="0" Canvas.Top="0"/>
                    <!-- Charge-limit ticks. Strokes come from the shared palette in code-behind, so
                         the charge-limit concept reads as one colour everywhere and no hex literal
                         here can drift from it. -->
                    <Path x:Name="GaugeStartTick"
                          StrokeThickness="2.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Canvas.Left="0" Canvas.Top="0"
                          Visibility="Collapsed"
                          Opacity="0.9"/>
                    <Path x:Name="GaugeStopTick"
                          StrokeThickness="2.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Canvas.Left="0" Canvas.Top="0"
                          Visibility="Collapsed"
                          Opacity="0.9"/>
                </Canvas>
                <!-- A glyph rather than a status word, which was wide enough to touch the arc.
                     Colour carries the state and is set in code. -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="-3">
                    <TextBlock x:Name="BatteryPercentText"
                               Text="--"
                               FontSize="23"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="StatusGlyph"
                               Text="●"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                <TextBlock x:Name="PowerSourceText"
                           Text="—"
                           Style="{StaticResource StatValueStyle}"/>
                <StackPanel Spacing="2">
                    <TextBlock x:Name="TimeRemainingText"
                               Text="—"
                               Style="{StaticResource StatValueStyle}"/>
                    <!-- Live %/hour reading, paired with REMAINING since both come from the same
                         charge-rate sample; the secondary brush keeps it from competing with the
                         two primary stat values now that neither carries a caption. -->
                    <TextBlock x:Name="ChargeRateText"
                               Text="—"
                               Style="{StaticResource StatValueStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- The graph is its own control so BatteryHistoryWindow can host the same drawing code at
             a larger size. PlotAreaHeight pins the canvas so this popup's measured size is fixed. -->
        <local:BatteryHistoryGraphControl x:Name="HistoryGraph"
                                           Grid.Row="2"
                                           Margin="0,0,0,8"
                                           PlotAreaHeight="126"/>

        <Border Grid.Row="3"
                Height="1"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                Margin="0,0,0,8"/>

        <!-- Badge padding is 5 top and bottom rather than the 6 a card would take: the section
             headings are a size larger here, and the popup is height-constrained. -->
        <StackPanel Grid.Row="4" Spacing="8">

            <Border x:Name="SmartChargeBadge"
                    CornerRadius="6"
                    Padding="10,5">
                <StackPanel Spacing="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- A second hit target for the switch, so a click anywhere on the badge
                             text works. The Background is required: a panel with no brush is not
                             hit-testable, leaving only the glyphs clickable. -->
                        <StackPanel x:Name="SmartChargeExpandedHeader"
                                    Grid.Column="0" Spacing="1"
                                    Background="Transparent"
                                    Tapped="OnSmartChargeLabelTapped">
                            <TextBlock Text="Smart Charge"
                                       Style="{StaticResource DashboardHeaderStyle}">
                                <!-- An explicit ToolTip rather than a plain string, which cannot
                                     carry two font weights. -->
                                <ToolTipService.ToolTip>
                                    <ToolTip>
                                        <StackPanel MaxWidth="280" Spacing="6">
                                            <TextBlock Text="Stops charging once your battery reaches your chosen limit, so it doesn't sit at 100% all day."
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.85">
                                                Batteries wear out fastest when kept fully charged for long periods — the chemistry inside degrades quicker at high charge levels, especially while powered and warm at the same time, like a laptop plugged in at a desk. Smart Charge keeps your battery in a gentler middle range instead, which can meaningfully extend how many years it lasts before you notice shorter runtime. Need a full charge before a trip? Use "Charge to 100% once" below — it lifts the limit for a single charge and switches back automatically.
                                            </TextBlock>
                                        </StackPanel>
                                    </ToolTip>
                                </ToolTipService.ToolTip>
                            </TextBlock>
                            <!-- Wrapping and trimming together: with neither set the line reports a
                                 desired width the star column cannot give it and the text runs on
                                 under the switch. Two lines is what the popup can spend. -->
                            <TextBlock x:Name="SmartChargeDetailText"
                                       Text="—"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       MaxLines="2"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <!-- "One line until it matters" (Settings > Appearance), off by default: the
                             dense alternative shown instead of the row above while Smart Charge is
                             off and not expanded. Never shown while Smart Charge is on. -->
                        <StackPanel x:Name="SmartChargeCollapsedHeader"
                                    Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    Visibility="Collapsed"
                                    Tapped="OnSmartChargeCollapsedRowTapped">
                            <TextBlock Text="Smart Charge" Style="{StaticResource DashboardHeaderStyle}"/>
                            <TextBlock Text="Off" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <!-- Empty On/OffContent and MinWidth 0 strip the default 154 px label
                             track, so the switch takes only the space it needs. The badge
                             background carries the active colour. -->
                        <ToggleSwitch Grid.Column="1"
                                      x:Name="SmartChargeToggle"
                                      OnContent=""
                                      OffContent=""
                                      MinWidth="0"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="Smart Charge"
                                      Toggled="OnSmartChargeToggled"/>
                        <!-- The expand/collapse affordance for the row above; visible only while
                             eligible (badge off and "One line until it matters" is on), in either the
                             collapsed or the expanded-in-place state. -->
                        <Border Grid.Column="2" x:Name="SmartChargeChevronHost"
                                Width="20" Height="20" Margin="4,0,0,0"
                                Background="Transparent"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Collapsed"
                                Tapped="OnSmartChargeCollapsedRowTapped">
                            <FontIcon x:Name="SmartChargeChevronGlyph"
                                      FontFamily="Segoe Fluent Icons" Glyph="&#xE70D;" FontSize="10"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </Border>
                    </Grid>

                    <!-- One dual-thumb selector rather than two sliders, so "charge between X and
                         Y" reads as a single control. Changes auto-apply, debounced, with no Apply
                         button. Minimum, Maximum and StepFrequency are set in code-behind: setting
                         them in XAML throws a XamlParseException on this Windows App SDK build. -->
                    <StackPanel x:Name="ThresholdSliders"
                                Spacing="0"
                                Margin="0,6,0,0"
                                Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="34"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="StartValueText"
                                       FontSize="11" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <controls:RangeSelector Grid.Column="1" x:Name="ThresholdRange"
                                    Height="28"
                                    ValueChanged="OnThresholdRangeChanged"/>
                            <TextBlock Grid.Column="2" x:Name="StopValueText"
                                       FontSize="11" VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Replaces the range picker on vendors with no numeric threshold, where a
                         draggable range would offer values the firmware silently ignores. The text
                         is set in code-behind because the cap figure comes from the vendor. -->
                    <TextBlock x:Name="ThresholdFixedNote"
                               FontSize="11"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="Collapsed"/>

                    <!-- Equal-width columns so every row ends flush with the button below, which a
                         wrapping panel with fixed cells cannot do. Columns, rows and spans are set
                         in code from the preset count and the measured width. -->
                    <Grid x:Name="PresetButtonPanel"
                          Margin="0,6,0,0"
                          Visibility="Collapsed"/>

                    <!-- Visible whenever Smart Charge is capable, so an active override can also be
                         cancelled from here. -->
                    <Button x:Name="TravelOverrideButton"
                            Content="🔝  Charge to 100 % once"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            FontSize="11"
                            Padding="8,4"
                            Margin="0,6,0,0"
                            Visibility="Collapsed"
                            Click="OnTravelOverrideButton"/>
                </StackPanel>
            </Border>

            <Border x:Name="SmartStandbyBadge"
                    CornerRadius="6"
                    Padding="10,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="SmartStandbyExpandedHeader"
                                Grid.Column="0" Spacing="1"
                                Background="Transparent"
                                Tapped="OnSmartStandbyLabelTapped">
                        <TextBlock Text="Smart Standby"
                                   Style="{StaticResource DashboardHeaderStyle}">
                            <ToolTipService.ToolTip>
                                <ToolTip>
                                    <StackPanel MaxWidth="280" Spacing="6">
                                        <TextBlock Text="Puts the computer into a deeper sleep after a period of inactivity, instead of the shallow sleep Windows uses by default."
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.85">
                                            Windows' default "Modern Standby" keeps parts of the computer lightly active with the lid closed, so it can check for notifications and updates in the background. That drains the battery slowly the whole time, including in a closed bag. Smart Standby schedules a deeper, fully-off sleep once the computer has been idle for a while, so it loses much less charge overnight. Only idle standby changes; a manual sleep is unaffected.
                                        </TextBlock>
                                    </StackPanel>
                                </ToolTip>
                            </ToolTipService.ToolTip>
                        </TextBlock>
                        <TextBlock x:Name="SmartStandbyDetailText"
                                   Text="—"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   MaxLines="2"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel x:Name="SmartStandbyCollapsedHeader"
                                Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                Visibility="Collapsed"
                                Tapped="OnSmartStandbyCollapsedRowTapped">
                        <TextBlock Text="Smart Standby" Style="{StaticResource DashboardHeaderStyle}"/>
                        <TextBlock Text="Off" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  x:Name="SmartStandbyToggle"
                                  OnContent=""
                                  OffContent=""
                                  MinWidth="0"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="Smart Standby"
                                  Toggled="OnSmartStandbyToggled"/>
                    <Border Grid.Column="2" x:Name="SmartStandbyChevronHost"
                            Width="20" Height="20" Margin="4,0,0,0"
                            Background="Transparent"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed"
                            Tapped="OnSmartStandbyCollapsedRowTapped">
                        <FontIcon x:Name="SmartStandbyChevronGlyph"
                                  FontFamily="Segoe Fluent Icons" Glyph="&#xE70D;" FontSize="10"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Smart Standby decides how the machine sleeps; this decides when. Only the switch and
                 the delay live here — locking at lid close stays in Settings. -->
            <Border x:Name="LidDelayBadge"
                    CornerRadius="6"
                    Padding="10,5">
                <StackPanel Spacing="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="LidDelayExpandedHeader"
                                    Grid.Column="0" Spacing="1"
                                    Background="Transparent"
                                    Tapped="OnLidDelayLabelTapped">
                            <TextBlock Text="Lid delay"
                                       Style="{StaticResource DashboardHeaderStyle}">
                                <ToolTipService.ToolTip>
                                    <ToolTip>
                                        <StackPanel MaxWidth="280" Spacing="6">
                                            <TextBlock Text="Waits before sleeping when the lid closes, instead of sleeping at once."
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.85">
                                                Turning this on sets the Windows lid-close action to "Do nothing" and runs a sleep timer instead; the Windows setting is put back when it is turned off. Opening the lid before the delay is up cancels it, and a running keep-awake session holds the sleep off entirely. Pick a delay from the row below — locking the computer at lid close, and delays other than these, are in Settings.
                                            </TextBlock>
                                        </StackPanel>
                                    </ToolTip>
                                </ToolTipService.ToolTip>
                            </TextBlock>
                            <TextBlock x:Name="LidDelayDetailText"
                                       Text="—"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       MaxLines="2"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel x:Name="LidDelayCollapsedHeader"
                                    Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    Visibility="Collapsed"
                                    Tapped="OnLidDelayCollapsedRowTapped">
                            <TextBlock Text="Lid delay" Style="{StaticResource DashboardHeaderStyle}"/>
                            <TextBlock Text="Off" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      x:Name="LidDelayToggle"
                                      OnContent=""
                                      OffContent=""
                                      MinWidth="0"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="Lid delay"
                                      Toggled="OnLidDelayToggled"/>
                        <Border Grid.Column="2" x:Name="LidDelayChevronHost"
                                Width="20" Height="20" Margin="4,0,0,0"
                                Background="Transparent"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Collapsed"
                                Tapped="OnLidDelayCollapsedRowTapped">
                            <FontIcon x:Name="LidDelayChevronGlyph"
                                      FontFamily="Segoe Fluent Icons" Glyph="&#xE70D;" FontSize="10"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </Border>
                    </Grid>

                    <!-- Both kinds of preset, each in its own labelled group. Built in code
                         (BuildLidChips) for the same reason the keep-awake row is: the sets come
                         from settings, and their look is set there rather than by a style out of
                         scope here. Columns and rows of this outer grid come from
                         LidDashboardPolicy.GroupsSideBySide. -->
                    <Grid x:Name="LidPresetGroups"
                          Margin="0,6,0,0"
                          ColumnSpacing="8"
                          RowSpacing="6">
                        <StackPanel x:Name="LidDelayGroup" Spacing="2">
                            <TextBlock Text="DELAY" Style="{StaticResource StatLabelStyle}"/>
                            <Grid x:Name="LidDelayPresetPanel"/>
                        </StackPanel>
                        <StackPanel x:Name="LidLevelGroup" Spacing="2">
                            <TextBlock Text="BATTERY" Style="{StaticResource StatLabelStyle}"/>
                            <Grid x:Name="LidLevelPresetPanel"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Never collapsed, unlike the three above: the hold is vendor-independent, so there is
                 no unsupported-hardware case to hide it for. -->
            <Border x:Name="KeepAwakeBadge"
                    CornerRadius="6"
                    Padding="10,5">
                <StackPanel Spacing="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="KeepAwakeExpandedHeader"
                                    Grid.Column="0" Spacing="1"
                                    Background="Transparent"
                                    Tapped="OnKeepAwakeLabelTapped">
                            <TextBlock Text="Keep Awake"
                                       Style="{StaticResource DashboardHeaderStyle}">
                                <ToolTipService.ToolTip>
                                    <ToolTip>
                                        <StackPanel MaxWidth="280" Spacing="6">
                                            <TextBlock Text="Stops your laptop going to sleep for a while — for a long download, a presentation, or a build."
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.85">
                                                Pick how long from the row below: a fixed span, a time of day, or "Net" — stay awake until you move to a different network, which is handy for keeping a machine up only while you are at a particular desk. It always ends by itself, so there is no way to forget it on overnight. Turning it off, or moving to another network on a "Net" session, releases the hold immediately.
                                            </TextBlock>
                                        </StackPanel>
                                    </ToolTip>
                                </ToolTipService.ToolTip>
                            </TextBlock>
                            <!-- A RichTextBlock, not a TextBlock, only so the screen phrase can be a
                                 real element inside the flowing line: it marks its own Tapped
                                 handled, which a Run cannot, and a near-miss must not reach the tap
                                 target around it and cancel the session. -->
                            <RichTextBlock x:Name="KeepAwakeDetailText"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis"
                                           IsTextSelectionEnabled="False"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Paragraph>
                                    <Run x:Name="KeepAwakeDetailRun" Text="—"/>
                                    <InlineUIContainer>
                                        <!-- A small tinted pill, the same vocabulary as the badges
                                             and preset chips, rather than an underlined web-style
                                             link — no other tappable element in the app looks like a
                                             hyperlink. CornerRadius and the code-behind Background
                                             give it the chip shape; a WinUI TextBlock has no
                                             Background of its own, so the Border also carries the fill
                                             that makes this hit-testable at all. The tint matches the
                                             badge's own on/costly brushes (set in code from AppColors). -->
                                        <Border x:Name="KeepAwakeScreenPhraseHost"
                                                CornerRadius="4"
                                                Padding="4,1,4,1"
                                                Visibility="Collapsed"
                                                Tapped="OnKeepAwakeScreenPhraseTapped">
                                            <TextBlock x:Name="KeepAwakeScreenPhrase"
                                                       FontSize="11"/>
                                        </Border>
                                    </InlineUIContainer>
                                    <Run x:Name="KeepAwakeDetailTailRun"/>
                                </Paragraph>
                            </RichTextBlock>
                        </StackPanel>
                        <StackPanel x:Name="KeepAwakeCollapsedHeader"
                                    Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    Visibility="Collapsed"
                                    Tapped="OnKeepAwakeCollapsedRowTapped">
                            <TextBlock Text="Keep Awake" Style="{StaticResource DashboardHeaderStyle}"/>
                            <TextBlock Text="Off" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      x:Name="KeepAwakeToggle"
                                      OnContent=""
                                      OffContent=""
                                      MinWidth="0"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="Keep Awake"
                                      Toggled="OnKeepAwakeToggled"/>
                        <Border Grid.Column="2" x:Name="KeepAwakeChevronHost"
                                Width="20" Height="20" Margin="4,0,0,0"
                                Background="Transparent"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Collapsed"
                                Tapped="OnKeepAwakeCollapsedRowTapped">
                            <FontIcon x:Name="KeepAwakeChevronGlyph"
                                      FontFamily="Segoe Fluent Icons" Glyph="&#xE70D;" FontSize="10"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </Border>
                    </Grid>

                    <!-- Built in code because the spans come from settings, and styled inline there
                         because TimeScaleButtonStyle is not in scope here. -->
                    <StackPanel x:Name="KeepAwakePresetPanel"
                                Orientation="Horizontal"
                                Spacing="4"
                                Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

    </Grid>
</Window>
