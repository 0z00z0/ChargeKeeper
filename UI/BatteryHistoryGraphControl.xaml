<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ChargeKeeper.UI.BatteryHistoryGraphControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- The resting, hover and pressed look shared by the time-scale buttons. The selection
             highlight changes at runtime and is applied per button in code-behind. -->
        <Style x:Key="TimeScaleButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- The time-scale row and legend's rest opacity, restored to 1 on pointer-enter over the
             graph card (RootGrid) in code-behind. Midpoint of the approved 35-45% range. The plotted
             line, its extremum markers and every axis label are never gated by this — they stay full
             opacity always. -->
        <x:Double x:Key="GraphChromeRestOpacity">0.4</x:Double>
    </UserControl.Resources>

    <!-- A Grid, not a StackPanel, so the plot row can take "*" from a resizable host: a StackPanel
         never gives a child more than its desired size along the stack axis. The card and the
         legend are direct children so nothing between that "*" and the card caps its growth. -->
    <Grid x:Name="RootGrid" RowSpacing="6"
          PointerEntered="OnGraphCardPointerEntered"
          PointerExited="OnGraphCardPointerExited">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- time-scale selector -->
            <RowDefinition Height="*"/>     <!-- sparkline card -->
            <RowDefinition Height="Auto"/>  <!-- legend -->
        </Grid.RowDefinitions>

        <!-- One toggle button per GraphTimeScale value, in order. The expand trigger is not in this
             row, so the buttons get the full width. Faded at rest and restored on pointer-enter (see
             RootGrid above) so the row reads as chrome rather than content while just glancing at
             the plot — the line, its markers and every axis label stay full opacity always. -->
        <StackPanel Grid.Row="0"
                    x:Name="TimeScalePanel"
                    Orientation="Horizontal"
                    Spacing="4"
                    Opacity="{StaticResource GraphChromeRestOpacity}">
            <Button x:Name="Scale15mButton" Content="15m" Tag="FifteenMinutes" Click="OnTimeScaleButtonClick" Style="{StaticResource TimeScaleButtonStyle}"/>
            <Button x:Name="Scale1hButton"  Content="1h"  Tag="OneHour"        Click="OnTimeScaleButtonClick" Style="{StaticResource TimeScaleButtonStyle}"/>
            <Button x:Name="Scale6hButton"  Content="6h"  Tag="SixHours"       Click="OnTimeScaleButtonClick" Style="{StaticResource TimeScaleButtonStyle}"/>
            <Button x:Name="Scale12hButton" Content="12h" Tag="TwelveHours"    Click="OnTimeScaleButtonClick" Style="{StaticResource TimeScaleButtonStyle}"/>
            <Button x:Name="Scale1dButton"  Content="1d"  Tag="OneDay"         Click="OnTimeScaleButtonClick" Style="{StaticResource TimeScaleButtonStyle}"/>
            <Button x:Name="Scale1wButton"  Content="1w"  Tag="OneWeek"        Click="OnTimeScaleButtonClick" Style="{StaticResource TimeScaleButtonStyle}"/>
            <Button x:Name="Scale14dButton" Content="14d" Tag="FourteenDays"   Click="OnTimeScaleButtonClick" Style="{StaticResource TimeScaleButtonStyle}"/>
        </StackPanel>

        <!-- Inert elements the annotation pills read their brushes from, rather than a code-behind
             resource lookup. The pill background must be a fully opaque brush: the Fluent fill
             brushes are translucent, and the line underneath would bleed through the pill. -->
        <TextBlock x:Name="GraphLabelPillTextBrushRef" Grid.Row="1" Visibility="Collapsed"
                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
        <Border x:Name="AnnotationPillBackgroundRef" Grid.Row="1" Visibility="Collapsed"
                Background="{ThemeResource SolidBackgroundFillColorBase}"/>

        <!-- SoC and charge limit on the left axis, charge power on the right, time along the
             bottom. The row takes "*" so a resizable host lets it grow; the dashboard pins it to a
             fixed height through PlotAreaHeight instead. -->
        <Border x:Name="SparklineCard"
                Grid.Row="1"
                CornerRadius="12"
                Padding="0,6,0,0"
                Background="{ThemeResource ControlFillColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="CanvasRow" Height="*"/>
                    <RowDefinition Height="Auto"/>  <!-- stress heat strip -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>   <!-- left % axis labels -->
                    <ColumnDefinition Width="*"/>    <!-- canvas -->
                    <ColumnDefinition Width="36"/>   <!-- right W axis labels -->
                </Grid.ColumnDefinitions>

                <!-- Left axis: SoC / limit %, 0 at bottom, 100 at top. -->
                <Grid Grid.Row="0" Grid.Column="0" Margin="6,2,3,4">
                    <TextBlock x:Name="LeftAxisTopLabel"    Text="100" FontSize="11" VerticalAlignment="Top"    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock x:Name="LeftAxisMidLabel"    Text="50"  FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock x:Name="LeftAxisBottomLabel" Text="0"   FontSize="11" VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </Grid>

                <!-- A Transparent Background so the empty plot area hit-tests: a Canvas with a null
                     Background takes no pointer input except where its children are, which would
                     limit double-tap-to-expand to the lines. -->
                <Canvas x:Name="SparklineCanvas" Grid.Row="0" Grid.Column="1"
                        Background="Transparent"
                        SizeChanged="OnCanvasSizeChanged"
                        DoubleTapped="OnCanvasDoubleTapped"
                        PointerMoved="OnCanvasPointerMoved"
                        PointerExited="OnCanvasPointerExited"/>

                <!-- Charge power, auto-scaled to the visible window and always including zero.
                     Populated in code because the range is dynamic. -->
                <Grid Grid.Row="0" Grid.Column="2" Margin="3,2,4,4">
                    <TextBlock x:Name="RightAxisTopLabel"    Text="—" FontSize="11" VerticalAlignment="Top"    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock x:Name="RightAxisMidLabel"    Text="—" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock x:Name="RightAxisBottomLabel" Text="—" FontSize="11" VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </Grid>

                <!-- Colour-codes time spent at high SoC across the visible window. Pop-out only,
                     for want of room in the small popup. The gradient is rebuilt in code on every
                     render, and Visibility is driven from code so the Auto row collapses to nothing
                     when hidden. Column 1 only, so the stops line up with the SoC samples above. -->
                <Rectangle x:Name="StressHeatmapBar"
                           Grid.Row="1"
                           Grid.Column="1"
                           Height="7"
                           Margin="0,5,0,1"
                           RadiusX="3.5"
                           RadiusY="3.5"/>

                <!-- Not a fixed span: the compressed x-axis collapses leading downtime, so the left
                     edge can be more recent than the selected time scale. Set in Render(). -->
                <Grid Grid.Row="2" Grid.Column="1" Margin="7,3,7,6">
                    <TextBlock x:Name="SparklineStartLabel"
                               Text="—"
                               FontSize="12"
                               HorizontalAlignment="Left"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock x:Name="SparklineEndLabel"
                               Text="now"
                               FontSize="12"
                               HorizontalAlignment="Right"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </Grid>

            </Grid>
        </Border>

        <!-- The expand button sits in its own row rather than overlaid on the canvas, where it
             reads as part of the graph and is obscured by the lines. Two columns, so the legend
             keeps its natural width and the button takes the rest. The glyph is SQUARE FOUR
             CORNERS: the diagonal arrow glyph is thin strokes in a mostly empty em-box and reads
             faint at any size. Colours are assigned in code-behind from AppColors. -->
        <Grid Grid.Row="2" Margin="4,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- A swatch and label per series; swatch colours are assigned in code-behind. Faded and
                 restored on the same terms as TimeScalePanel above — the ExpandGlyph button beside it
                 is its own always-visible affordance and is not part of this fade. -->
            <StackPanel x:Name="LegendPanel" Grid.Column="0" Orientation="Horizontal" Spacing="14"
                        VerticalAlignment="Center"
                        Opacity="{StaticResource GraphChromeRestOpacity}">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border x:Name="LegendSocSwatch" Width="8" Height="8" CornerRadius="4"/>
                    <TextBlock Text="SoC" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border x:Name="LegendLimitSwatch" Width="8" Height="8" CornerRadius="4"/>
                    <TextBlock Text="Limit" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border x:Name="LegendPowerSwatch" Width="8" Height="8" CornerRadius="4"/>
                    <TextBlock Text="Power" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- The same footprint as the time-scale buttons. Width and Height are pinned rather
                 than auto-sized, because the glyph and a label like "15m" measure differently, and
                 the tighter Padding lets the glyph read large inside that same box. -->
            <Button x:Name="ExpandGlyph"
                    Grid.Column="1"
                    Style="{StaticResource TimeScaleButtonStyle}"
                    Content="⛶"
                    FontSize="18"
                    FontWeight="Bold"
                    Padding="3"
                    Width="36"
                    Height="28"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Expand"
                    Click="OnExpandGlyphClick"/>
        </Grid>
    </Grid>
</UserControl>
