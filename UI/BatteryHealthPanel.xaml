<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ChargeKeeper.UI.BatteryHealthPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Health moves over months, so it gets its own panel rather than a third series on the
         SoC/Power graph, whose gap-collapsing x-axis would misrepresent it. -->
    <Border CornerRadius="12"
            Padding="16,12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="90"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="BATTERY HEALTH"
                       Style="{StaticResource StatLabelStyle}"/>

            <TextBlock x:Name="SummaryText" Grid.Row="1"
                       Text="Gathering data…"
                       Style="{StaticResource StatValueStyle}"
                       TextWrapping="Wrap"/>

            <!-- Solid line is logged capacity, dashed is the linear projection. Drawn in code
                 because the series is dynamic. -->
            <Canvas x:Name="TrendCanvas" Grid.Row="2"
                    Background="Transparent"
                    SizeChanged="OnCanvasSizeChanged"/>
        </Grid>
    </Border>
</UserControl>
