<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ChargeKeeper.UI.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ChargeKeeper.UI"
    xmlns:brand="using:ZeroZero.Brand.WinUI"
    mc:Ignorable="d">

    <!-- The chrome is this app's; the content is the shared BrandAboutControl, which carries no
         update button so the tray keeps that job. -->
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <ScrollViewer x:Name="ContentScroller" Padding="24" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <!-- The "What's new" entry sits BESIDE the shared control rather than inside it: the report
             is this application's, and putting it in the shared control would be a change to a
             module another repository owns. -->
        <StackPanel x:Name="ContentPanel" MaxWidth="560" HorizontalAlignment="Center" Spacing="12">
            <brand:BrandAboutControl x:Name="About"/>
            <Button x:Name="WhatsNewButton" Content="What's new" HorizontalAlignment="Center"
                    Click="OnWhatsNew"/>
        </StackPanel>
    </ScrollViewer>
</Window>
