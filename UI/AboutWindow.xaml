<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ChargeKeeper.UI.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ChargeKeeper.UI"
    xmlns:brand="using:ZeroZero.Brand.WinUI"
    mc:Ignorable="d">

    <!-- The chrome is this app's: a frameless popup like the pop-out graph, dismissed by clicking
         away or Escape. The content is the shared BrandAboutControl, whose button row carries this
         application's What's new, and below it the same Check for updates button the Settings
         window's About page carries. -->
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <!-- KeyboardAcceleratorPlacementMode Hidden: WinUI otherwise shows the accelerator's key as a
         tooltip ("Esc") over every part of the window without a tooltip of its own. -->
    <Grid x:Name="RootGrid" KeyboardAcceleratorPlacementMode="Hidden">
        <!-- Escape dismisses exactly as clicking away does. On the root so it fires wherever focus
             sits. -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked"/>
        </Grid.KeyboardAccelerators>

        <ScrollViewer x:Name="ContentScroller" Padding="24" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ContentPanel" MaxWidth="560" HorizontalAlignment="Center" Spacing="12">
                <brand:BrandAboutControl x:Name="About"/>
                <!-- Under the card, on its own: the check is this application's. -->
                <brand:BrandBracketButton x:Name="CheckForUpdatesButton" HorizontalAlignment="Center"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
