<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Same TFM/platforms as the app so the win-* RID publish graph resolves without
         AnyCPU↔x64 mapping noise (the .slnx deliberately declares no "Any CPU" config). -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ChargeKeeper.Vendors.Surface</RootNamespace>
    <Platforms>x86;x64;ARM64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Abstractions\ChargeKeeper.Vendors.Abstractions.csproj" />
  </ItemGroup>

  <!-- Same reason as the HP project: the mode mapping and range guards are internal but are the
       part worth testing, and they must be testable on a NON-Surface machine. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ChargeKeeper.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- NO PackageReference, and deliberately no reference to any Surface assembly. The mechanism
       that reads/writes Battery Limit from Windows is not confirmed yet (see
       SurfaceBatteryLimitApi), so this project takes no dependency it might have to undo.
       Whoever implements ISurfaceBatteryLimitTransport adds it here. -->
</Project>
