<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Same TFM/platforms as the app so the win-* RID publish graph resolves without
         AnyCPU↔x64 mapping noise (the .slnx deliberately declares no "Any CPU" config). -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ChargeKeeper.Vendors.Hp</RootNamespace>
    <Platforms>x86;x64;ARM64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Abstractions\ChargeKeeper.Vendors.Abstractions.csproj" />
  </ItemGroup>

  <!-- The decision logic (mode mapping, range guards) is internal but is the part worth
       testing, and it must be testable on a NON-HP machine — calling the public
       SetThresholds in a test would write to real firmware. Mirrors how ChargeKeeper.csproj
       exposes its internals to the same test project. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ChargeKeeper.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- WMI access to root\HP\InstrumentedBIOS. Unlike the Lenovo module there is NO native
         bridge to build: HP's BIOS surface is reachable straight from managed code. -->
    <PackageReference Include="System.Management" />
  </ItemGroup>
</Project>
