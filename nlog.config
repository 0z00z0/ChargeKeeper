<?xml version="1.0" encoding="utf-8"?>
<!--
  The app's forensic trail: %AppData%\ChargeKeeper\app.log, plus power.log for the power/sleep
  events (a filter over the same trail, not a slice out of it — see the powerfile target). Retention
  and size live HERE, not in code, so they can be changed on an installed machine without a rebuild.

  Loaded automatically by NLog from beside the exe (see Services/AppLog.cs). If this file is missing
  or unparseable, AppLog falls back to an EQUIVALENT config built in code rather than logging
  nothing — the reasoning is in AppLog's remarks.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      internalLogLevel="Off">

  <targets>
    <!--
      Two settings here are the successor to the FileShare fix that #34 ("AppLog silently drops
      lines") bought with real debugging time, and NEITHER is decoration. Measured on the real #34
      scenario (6 concurrent processes x 120 lines each):

        keepFileOpen="true" (NLog's DEFAULT) ............ ~70 lines lost, silently
        keepFileOpen="false", no RetryingWrapper ........ ~1-3 lines lost, silently
        keepFileOpen="false" + RetryingWrapper (shipped)  0 lines lost

      NLog reports none of those losses — not even to its own internal log — so a drop here is as
      invisible as the old catch{} was. retryCount/retryDelayMilliseconds mirror what SafeFileAppend
      did by hand: a short bounded retry to ride out a sibling process's in-flight append or an AV
      scan.
    -->
    <target name="appfile" xsi:type="RetryingWrapper" retryCount="5" retryDelayMilliseconds="20">
      <!--
      keepFileOpen="false" is the load-bearing setting, and the successor to the FileShare fix that
      #34 ("AppLog silently drops lines") bought with real debugging time. Sibling ChargeKeeper
      processes — the ~288/day watchdog probes, a self-heal relaunch, an OnProcessExit handler racing
      the startup handoff — append to this same file concurrently. keepFileOpen="false" makes NLog
      open the file per write with a share mode that tolerates other writers and retry a collision,
      which is what the hand-rolled SafeFileAppend did with FileMode.Append + FileShare.ReadWrite.
      With the default keepFileOpen="true" NLog holds an exclusive handle and a sibling process's
      writes are lost — the exact #34 regression.

      NB: do NOT "restore" concurrentWrites="true" here. That was NLog 5's name for this behaviour;
      NLog 6 REMOVED the property, and an unknown attribute is silently ignored unless
      throwConfigExceptions is on — so it would look correct, do nothing, and lose lines again.
      NLogConfigTests loads this very file with throwConfigExceptions="true" and asserts these
      settings, so a typo or a stale-name attribute fails the build instead of failing in the field.

      Rotation: archiveEvery="Day" moves the active file to app_<date>_00.log at the first write
      after midnight (NLog probes the file's birth time), maxArchiveDays="7" deletes archives older
      than seven days, and archiveAboveSize stays as a within-day guard. NLog 6 renamed this area:
      archiveNumbering and archiveDateFormat are OBSOLETE in 6.1.4 and archiveSuffixFormat replaces
      both, so a config written in NLog 5's idiom parses and rotates nothing. NLogConfigTests drives
      a logger against a temp directory and asserts the files that actually appear and disappear.

      The layout has NO trailing newline. lineEnding="LF" already terminates the entry; carrying
      both put a blank line between every pair of entries. The class column comes from an event
      property the AppLog/PowerLog facades fill from [CallerFilePath] — free, and correct across
      async boundaries, where ${callsite} costs 2.2x per entry and reports the facade.

      The layout carries the #34-review lesson too: ${date} has NO culture= parameter because
      NLog's ${date} already defaults to InvariantCulture, and this timestamp is machine-facing log
      data that must stay Gregorian/ASCII on every locale. Do not "fix" the apparent omission by
      adding culture="" — an EMPTY culture makes NLog fall back to the thread's CurrentCulture,
      which stamps a non-Gregorian year (verified: 1448-02-03 under ar-SA), the very bug the review
      caught. culture=Invariant is not a thing and throws. NLogConfigTests renders this layout under
      ar-SA and asserts a Gregorian year, so either mistake fails the build.
      -->
      <target name="appfile_file"
              xsi:type="File"
              fileName="${specialfolder:folder=ApplicationData}\ChargeKeeper\app.log"
              keepFileOpen="false"
              createDirs="true"
              encoding="utf-8"
              writeBom="false"
              archiveAboveSize="10485760"
              archiveEvery="Day"
              maxArchiveDays="7"
              archiveSuffixFormat="_{1:yyyy-MM-dd}_{0:00}"
              lineEnding="LF"
              layout="[${date:format=yyyy-MM-dd HH\:mm\:ss zzz}] ${level:uppercase=true:padding=-5} ${pad:padding=-24:inner=${event-properties:item=class:whenEmpty=-}} ${message}" />
    </target>

    <!--
      The power/sleep trail: %AppData%\ChargeKeeper\power.log. Suspend/resume, the lid, the lid-close
      delay, keep-awake holds, Smart Standby scheduling, the display settle and AC/battery swaps — a
      file you can read start to finish when the machine did not sleep (or would not stay awake),
      instead of picking those lines out of app.log by eye.

      Every setting matches appfile above, and for the same reasons: sibling ChargeKeeper processes
      append here too, so keepFileOpen="false" + the RetryingWrapper are the #34 fix again, not
      decoration. Do NOT add concurrentWrites here either — see the long note above.

      The ONE deliberate difference is the layout: milliseconds instead of the offset and the level.
      Order inside a second is what this file is for ("lid closed, hold taken, delay armed" reads
      differently in any other order), and every line here is an event rather than a severity. As
      above, ${date} takes NO culture= parameter.
    -->
    <target name="powerfile" xsi:type="RetryingWrapper" retryCount="5" retryDelayMilliseconds="20">
      <target name="powerfile_file"
              xsi:type="File"
              fileName="${specialfolder:folder=ApplicationData}\ChargeKeeper\power.log"
              keepFileOpen="false"
              createDirs="true"
              encoding="utf-8"
              writeBom="false"
              archiveAboveSize="10485760"
              archiveEvery="Day"
              maxArchiveDays="7"
              archiveSuffixFormat="_{1:yyyy-MM-dd}_{0:00}"
              lineEnding="LF"
              layout="[${date:format=yyyy-MM-dd HH\:mm\:ss.fff}] ${pad:padding=-24:inner=${event-properties:item=class:whenEmpty=-}} ${message}" />
    </target>
  </targets>

  <rules>
    <!--
      Matched by LOGGER NAME (Services/PowerLog.cs), so routing is a decision at the call site rather
      than an accident of which namespace a class sits in. Deliberately NOT final="true": the rule
      below still writes the same line to app.log, because a power event is read against the startup
      and teardown chatter around it. This file is a filter over the trail, not a slice out of it.
    -->
    <logger name="ChargeKeeper.Power" minlevel="Info" writeTo="powerfile" />
    <logger name="*" minlevel="Info" writeTo="appfile" />
  </rules>
</nlog>
