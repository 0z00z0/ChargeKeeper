<Project Sdk="Microsoft.NET.Sdk">

  <!-- The build kit's WinUI application block: output type, target framework and minimum platform,
       UseWinUI, WindowsPackageType None, EnableMsixTooling, WinUISDKReferences, the runtime
       identifier from the process architecture, and DefaultLanguage en-GB. Imported at the top so
       this project's own properties below still win. The kit's other three imports are at the
       repository root, and its version is in global.json. This project keeps its own app.manifest,
       so the kit writes none. -->
  <Import Project="ZeroZero.WinUIApp.props" Sdk="ZeroZero.Build" />

  <PropertyGroup>
    <RootNamespace>ChargeKeeper</RootNamespace>
    <Version>1.48.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Suppresses the XAML-generated Program.Main in favour of Program.cs. The generated one goes
         straight to Application.Start, so the whole Windows App SDK + XAML stack (234 MB / 302 DLLs
         of install) booted before any of our code could decide the process had no business running
         — which the ~288 watchdog probes a day, and every /debug command, then paid for only to
         exit. Program.cs owns the reasoning. Append, never assign: the SDK puts DEBUG/TRACE in
         $(DefineConstants) and a bare value would drop them. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- Identity / packaging metadata -->
    <AssemblyTitle>ChargeKeeper</AssemblyTitle>
    <Product>ChargeKeeper</Product>
    <Description>Keeps your laptop battery healthy — charge limits, a live battery gauge and smart standby control from the system tray.</Description>
    <Authors>ZeroZero Software</Authors>
    <Company>ZeroZero Software</Company>
    <Copyright>Copyright © 2026 ZeroZero Software</Copyright>
    <RepositoryUrl>https://github.com/0z00z0/ChargeKeeper</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- InvariantGlobalization is left OFF (default). It was briefly suspected of causing the
         dashboard's "Failed to assign to property RangeBase.Minimum" XamlParseException, but that
         was disproved — the real fix is setting Slider Min/Max in code-behind (see
         DashboardWindow.ConfigureSliderRanges). Kept off as a precaution against other culture-
         sensitive WinUI controls (e.g. NumberBox); re-enable only if installer size matters and
         the UI is re-verified. -->
    <Platforms>x86;x64;ARM64</Platforms>
    <!-- Bundle the Windows App SDK runtime when publishing self-contained. Declared as a
         PROJECT-level property here (conditioned on the self-contained publish) rather than a
         command-line -p:WindowsAppSDKSelfContained=true global in build-installer.ps1, because a
         command-line global propagates into the referenced ZeroZero.Brand.WinUI class library,
         where the WindowsAppSDK targets reject it ("should not be applied to a class library").
         A project property stays local to this app and never reaches the reference. -->
    <WindowsAppSDKSelfContained Condition="'$(SelfContained)' == 'true'">true</WindowsAppSDKSelfContained>
    <!-- Embeds the multi-size icon in the exe so it shows in Programs & Features,
         the uninstall entry, Explorer, and the UAC elevation prompt. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Exposes internal types (BatteryHistoryService, HistoryDownsampler, GraphTimeScaleExtensions,
       etc.) to the unit test project so tests can exercise them directly without a public API. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ChargeKeeper.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Tests/ is a subfolder of this project's directory but belongs to the separate
       ChargeKeeper.Tests project — exclude it from this project's default **/*.cs glob, or its
       xUnit-only source (referencing types this WinExe project doesn't reference) gets compiled
       into BOTH projects and fails to build here. -->
  <ItemGroup>
    <Compile Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
    <!-- WinUI's targets also glob every image file into Content — without this Remove, the PNGs
         in Tests\bin get copied into this project's output, which the next Tests build copies
         back, nesting one level deeper per build until MAX_PATH kills the build (MSB3021). -->
    <Content Remove="Tests\**" />
    <!-- WinUI ALSO globs every **/*.xaml as a Page to compile. The test project transitively
         references a WinUI library (ZeroZero.Brand.WinUI), so its BrandAboutWindow.xaml lands in
         Tests\bin — without this Remove the publish's XAML compiler picks up that copy, generates
         a BrandAboutWindow.g.i.cs, and it collides with the real referenced type (CS0436 + CS1729).
         Harmless before the 0z0-shared reference existed (no external .xaml sat in Tests\bin). -->
    <Page Remove="Tests\**" />
    <ApplicationDefinition Remove="Tests\**" />
  </ItemGroup>

  <!-- Vendor power-management modules live in their own projects (referenced below) so more
       vendors (e.g. HP) can coexist later. Vendors/ sits under this project's directory, so it
       must be excluded from this WinExe's **/*.cs glob for the same reason Tests/ is — its
       sources would otherwise compile into BOTH assemblies as duplicate types. -->
  <ItemGroup>
    <Compile Remove="Vendors\**" />
    <EmbeddedResource Remove="Vendors\**" />
    <None Remove="Vendors\**" />
    <Content Remove="Vendors\**" />
  </ItemGroup>

  <!-- publish\ is this project's OWN publish output (installer\build-installer.ps1 publishes the
       app into <repo>\publish, which ISCC then packs). It sits under the project directory, so the
       default globs suck the previous publish back in as INPUT to the next build — the same
       feedback loop the Tests\** Content Remove above documents, and the reason to kill it here.
       It is gitignored, so these item groups are invisible in review and only reproduce on a
       machine that has actually built an installer.
       Not theoretical: without these Removes, `-getItem:Content` lists publish\Assets\AppIcon.png
       and publish\Microsoft.UI.Xaml\Assets\NoiseAsset_256x256_PNG.png, and the WinUI targets copy
       Content to the output preserving RelativeDir — bin\...\win-x64\publish\Assets\AppIcon.png
       was present in the Debug, Release and x64\Debug trees when this guard was added. (Note the
       trap: a glob-only Content item has NO CopyToOutputDirectory, but the WinUI/Windows App SDK
       targets copy it anyway — CopyToOutputDirectory governs the plain SDK's copy, not theirs. So
       "no metadata" does NOT mean "not copied".) Each installer build then republishes that copy
       one level deeper, which is how the Tests\** case ended in MAX_PATH/MSB3021.
       The None glob is the bulk of it by count: 559 items, nearly all Microsoft.UI.Xaml *.mui
       satellites.
       Page is removed pre-emptively rather than reactively — an OUTPUT tree demonstrably can carry
       a referenced WinUI library's loose .xaml (Tests\bin holds ZeroZero.Brand.WinUI's
       BrandAboutWindow.xaml today, which is exactly why Tests\** needs its own Page Remove); a
       second copy makes the XAML compiler emit a colliding *.g.i.cs (CS0436). publish\ carries no
       .xaml only because an unpackaged publish folds XAML into the .pri — a property of the
       publish pipeline, not a guarantee worth relying on.
       No Compile/EmbeddedResource Remove here, unlike Tests\** and Vendors\**: those hold SOURCES
       that would compile into two assemblies as duplicate types, whereas publish\ is build output
       and contains no .cs/.resx (verified zero). Add them if that ever stops being true. -->
  <ItemGroup>
    <Content Remove="publish\**" />
    <None Remove="publish\**" />
    <Page Remove="publish\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Vendors\Abstractions\ChargeKeeper.Vendors.Abstractions.csproj" />
    <ProjectReference Include="Vendors\Lenovo\ChargeKeeper.Vendors.Lenovo.csproj" />
    <ProjectReference Include="Vendors\Hp\ChargeKeeper.Vendors.Hp.csproj" />
    <ProjectReference Include="Vendors\Surface\ChargeKeeper.Vendors.Surface.csproj" />
  </ItemGroup>

  <!-- ChargeThresholdState (and friends) moved to the vendor-abstractions namespace with the
       split; imported globally so the many existing call sites keep compiling unqualified. -->
  <ItemGroup>
    <Using Include="ChargeKeeper.Vendors" />
  </ItemGroup>

  <ItemGroup>
    <!-- NLog auto-discovers nlog.config BESIDE THE EXE at runtime, so it must reach both the build
         output and the publish output (installer\build-installer.ps1 publishes into <repo>\publish,
         which ISCC packs with recursesubdirs). Without CopyToOutputDirectory it would stay in the
         repo, NLog would find no config, and the app's only forensic trail would go silent with no
         error — the same shape of bug as Assets\AppIcon.ico shipping without this metadata and
         SetIcon then quietly no-op'ing. AppLog degrades to a code-built config rather than going
         dark if this ever fails anyway, and NLogConfigTests asserts the file is in the test output
         (which is fed by this very item through the ProjectReference). -->
    <Content Include="nlog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- CopyToOutputDirectory matters: TitleBarTheme.ApplyDark resolves this by path at runtime
         (AppWindow.SetIcon) and silently does nothing if the file isn't beside the exe. -->
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- SetupIcon.ico is the INSTALLER's dense light-chrome variant: Inno reads it straight from
         the repo (SetupIconFile=..\Assets\SetupIcon.ico), and nothing in the app references it.
         WinUI's targets glob every image file into Content, so without this Remove it would be
         copied into the app output as dead weight AND indexed into ChargeKeeper.pri. Verified by
         toggling the Remove: without it, bin\...\Assets\SetupIcon.ico exists and "SetupIcon"
         appears in the .pri; with it, neither does.
         Do NOT "correct" this to say a glob-only item is never copied because it carries no
         CopyToOutputDirectory. That metadata gates the plain .NET SDK's copy — the WinUI/Windows
         App SDK targets copy Content regardless, which is why the metadata-less Assets\StoreLogo
         .png and friends reach the output too. Deleting an explicit Include is therefore NOT
         sufficient to keep a file out; this Remove is what does it. -->
    <Content Remove="Assets\SetupIcon.ico" />
    <!-- AppIcon.png has no consumer: the Settings pane footer and the Dashboard header both draw
         the mark natively through Helpers\BrandMarkImage, so no ms-appx:///Assets/AppIcon.png URI
         resolves anywhere in the app, the installer reads only the two .ico files, and no test
         asserts the PNG. Removed rather than merely un-Included for the reason the SetupIcon.ico
         note above gives: the WinUI image glob picks the file up regardless, so dropping the
         explicit Include would leave it shipping and indexed into ChargeKeeper.pri. The file stays
         in the repo — scripts\make-appicon.ps1 emits it alongside the .ico as a general-purpose
         brand export. -->
    <Content Remove="Assets\AppIcon.png" />
    <!-- #52: bespoke two-tone Settings nav icons (steel + sage + terracotta). Shipped as SVG
         assets so ms-appx:///Assets/nav/*.svg resolves for the NavigationView ImageIcons. -->
    <Content Include="Assets\nav\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- The "What's new" report. Embedded rather than fetched: the requirement is that the report
         is always reachable, and an "always" that depends on a network is not one. The release
         workflow publishes the section for the tag it builds, so the report and the release page
         read from one text. -->
    <EmbeddedResource Include="RELEASE-NOTES.md" LogicalName="ChargeKeeper.RELEASE-NOTES.md" />
  </ItemGroup>

  <!-- Application strings, resolved through MRT Core via x:Uid — see LOCALISATION.md. .resw rather
       than .resx: x:Uid support, one culture-resolution system shared with the rest of WinUI, no
       satellite-assembly installer weight. Requires no build-configuration change beyond this item;
       verified with a throwaway project carrying the identical WindowsPackageType=None property
       set. One language today (#152); a second is #164. -->
  <ItemGroup>
    <PRIResource Include="Strings\en-GB\Resources.resw" />
  </ItemGroup>

  <!--
    Native bridge to the Lenovo Power Manager RPC interface (Smart Charge thresholds).
    Built separately via native\build.cmd; copied next to the app so the P/Invoke in
    ChargeThresholdService can load it. Not part of the managed compile.
  -->
  <ItemGroup>
    <None Include="native\LenPower.dll" Condition="Exists('native\LenPower.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>LenPower.dll</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- No version attribute anywhere: every version is pinned centrally in
       Directory.Packages.props, the family's pins above this repository's own. A version here fails
       the build (ZZB006). -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.RangeSelector" />
    <!-- Same toolkit family/version as RangeSelector above (TODO #19 spec: do not bump/mismatch) —
         SettingsCard/SettingsExpander rows for the Settings window. -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="H.NotifyIcon.WinUI" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <!-- Backs Services/AppLog; adopted to get bounded log rotation (app.log grew unbounded) rather
         than re-inventing it. -->
    <PackageReference Include="NLog" />
    <PackageReference Include="System.Drawing.Common" />
    <!-- WMI, for Services/HyperVUplinkBindings: MSFT_NetAdapterBindingSettingData is how Windows
         names the NIC an external Hyper-V switch is bound to, which the MAC walk-back can only
         infer. The package ships in a self-contained unpackaged publish. -->
    <PackageReference Include="System.Management" />
    <!-- Services/ThermalZoneReader: the "Thermal Zone Information" performance-counter category is
         no longer part of the runtime on .NET Core/5+ — PerformanceCounter was forwarded out to this
         package. -->
    <PackageReference Include="System.Diagnostics.PerformanceCounter" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
    <PackageReference Include="TaskScheduler" />
    <!-- WindowExtensions.CenterOnScreen on the Settings window; NOT WindowEx or PersistenceId (the
         latter persists via Windows.Storage.ApplicationData, unavailable to this unpackaged app —
         the Settings window's rect persists through SettingsService/JSON instead). -->
    <PackageReference Include="WinUIEx" />
  </ItemGroup>

  <!-- The shared library, as packages from the family feed. Versions are pinned centrally in
       Directory.Packages.props and never on the reference. Three references cover everything this
       application takes: the brand component for the About window, in place of a hand-rolled
       UI/AboutWindow; the MQTT module; and the sectioned settings store, which holds
       settings.json. ZeroZero.Mqtt.WinUI brings ZeroZero.Mqtt.Discovery, ZeroZero.Mqtt,
       ZeroZero.Controls.WinUI, ZeroZero.Primitives and ZeroZero.Win32 with it, and MQTTnet
       transitively inside ZeroZero.Mqtt, which is the only assembly that sees it — no
       client-library type reaches a public signature, so this application references MQTTnet
       nowhere. ZeroZero.Config.Sections is a direct reference because it arrives with nothing
       whatever else is adopted; it brings ZeroZero.Config with it. Declaring any of the others here
       would resolve the same assembly twice. Integration contract in README; implementation guide
       in the shared library's own MQTT document. -->
  <ItemGroup>
    <PackageReference Include="ZeroZero.Brand.WinUI" />
    <PackageReference Include="ZeroZero.Config.Sections" />
    <PackageReference Include="ZeroZero.Mqtt.WinUI" />
  </ItemGroup>

  <!--
    Authenticode-sign the produced executable on Release builds.
    Delegates to sign.ps1, which signs with the self-signed cert created by
    'sign.ps1 -Setup'. ContinueOnError keeps the build green if no cert is present.
    The signing itself belongs to the build kit's own script, whose path the kit publishes as
    ZeroZeroSigningScript and which resolves inside the restored SDK package.
  -->
  <Target Name="SignOutput" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\scripts\sign.ps1&quot; -Path &quot;$(TargetDir)$(AssemblyName).exe&quot; -Signer &quot;$(ZeroZeroSigningScript)&quot;" ContinueOnError="true" />
  </Target>

  <!-- Publish properties: ReadyToRun on Release; trimming OFF (WinUI + reflection-y bits are
       fragile to trim). -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!--
    `dotnet publish` for an unpackaged WinUI 3 app drops the app resource index
    ($(AssemblyName).pri, e.g. ChargeKeeper.pri) — it holds the compiled XAML resources
    (App.xaml dictionaries, control templates). Without it Microsoft.UI.Xaml.dll crashes
    at startup with a stowed exception (0xC000027B). Copy it into the publish output.
  -->
  <Target Name="CopyAppPriToPublish" AfterTargets="Publish" Condition="Exists('$(OutDir)$(AssemblyName).pri')">
    <Copy SourceFiles="$(OutDir)$(AssemblyName).pri" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <!--
    Remove the Windows App SDK ML/ONNX subsystem from the publish output.
    Microsoft.WindowsAppSDK pulls in Microsoft.Windows.AI.MachineLearning as a transitive
    dependency, which adds onnxruntime.dll (20 MB), DirectML.dll (18 MB), and friends.
    This app uses no Windows.AI APIs; the DLLs are only loaded on demand when those APIs are
    called, so removing them is safe and saves ~38 MB from the installer.
  -->
  <Target Name="PrunePublishOutput" AfterTargets="Publish">
    <ItemGroup>
      <_FilesToPrune Include="$(PublishDir)onnxruntime.dll" />
      <_FilesToPrune Include="$(PublishDir)DirectML.dll" />
      <_FilesToPrune Include="$(PublishDir)onnxruntime_providers_shared.dll" />
      <_FilesToPrune Include="$(PublishDir)Microsoft.ML.OnnxRuntime.dll" />
    </ItemGroup>
    <Delete Files="@(_FilesToPrune)" Condition="Exists('%(Identity)')" />
    <Message Text="Pruned unused ML/ONNX files from publish output." Importance="high" />
  </Target>
</Project>
