<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ChargeKeeper.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The studio chrome palette, overriding the WinUI theme brushes every window already
                 references so no window needs its own edit. Values come from
                 0z0-design/design-language.md.

                 Chrome only: the product colours in Helpers/AppColors.cs and GaugePalette.cs are
                 ChargeKeeper's own identity and are not touched here.

                 Only the Default (dark) dictionary exists, because the Application pins
                 RequestedTheme to Dark and the studio palette is dark by design. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <!-- Text -->
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"   Color="#dde6f4"/>
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#93a4bb"/>
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush"  Color="#64788f"/>
                    <SolidColorBrush x:Key="TextFillColorDisabledBrush"  Color="#45566a"/>
                    <!-- Hairlines / dividers / strokes -->
                    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush"  Color="#1a2840"/>
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush"  Color="#1a2840"/>
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush"     Color="#1a2840"/>
                    <!-- Card / panel surfaces (SettingsCard, BatteryHealthPanel) -->
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush"   Color="#0e1620"/>
                    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#101a26"/>
                    <!-- The paired *Color* keys and the SystemAccentColor ramp below must agree with
                         these brushes: several control visual-states resolve the accent COLOR rather
                         than the AccentFill brush, and would otherwise paint the OS accent. -->
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush"   Color="#7FA8B8"/>
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E67FA8B8"/>
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush"  Color="#CC7FA8B8"/>
                    <Color x:Key="AccentFillColorDefaultColor">#7FA8B8</Color>
                    <Color x:Key="AccentFillColorSecondaryColor">#E67FA8B8</Color>
                    <Color x:Key="AccentFillColorTertiaryColor">#CC7FA8B8</Color>
                    <Color x:Key="AccentTextFillColorPrimaryColor">#7FA8B8</Color>
                    <Color x:Key="SystemAccentColor">#7FA8B8</Color>
                    <Color x:Key="SystemAccentColorLight1">#9BBBC8</Color>
                    <Color x:Key="SystemAccentColorLight2">#B7CED7</Color>
                    <Color x:Key="SystemAccentColorLight3">#D4E1E7</Color>
                    <Color x:Key="SystemAccentColorDark1">#698B99</Color>
                    <Color x:Key="SystemAccentColorDark2">#546F79</Color>
                    <Color x:Key="SystemAccentColorDark3">#40545C</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- The studio palette as named brushes, for chrome XAML that names a colour directly. -->
            <SolidColorBrush x:Key="BrandBgBrush"     Color="#0a0f17"/>
            <SolidColorBrush x:Key="BrandBg2Brush"    Color="#0e1620"/>
            <SolidColorBrush x:Key="BrandBg3Brush"    Color="#101a26"/>
            <SolidColorBrush x:Key="BrandBorderBrush" Color="#1a2840"/>
            <SolidColorBrush x:Key="BrandTextBrush"   Color="#dde6f4"/>
            <SolidColorBrush x:Key="BrandMutedBrush"  Color="#64788f"/>
            <SolidColorBrush x:Key="BrandTealBrush"   Color="#27e0c8"/>
            <SolidColorBrush x:Key="BrandBlueBrush"   Color="#11a9d6"/>
            <SolidColorBrush x:Key="BrandPurpleBrush" Color="#7b8cff"/>
            <SolidColorBrush x:Key="BrandIndigoBrush" Color="#3f5be0"/>

            <!-- Cascadia Mono is the studio's UI face throughout, not only for code. The .ttf comes
                 from ZeroZero.Brand.WinUI's output under Assets\Fonts\, so it is not re-bundled. -->
            <FontFamily x:Key="BrandFont">ms-appx:///Assets/Fonts/CascadiaMono.ttf#Cascadia Mono</FontFamily>

            <!-- Templated controls resolve these two theme resources rather than the implicit
                 TextBlock style, so both are needed for the font to reach every control. A literal
                 URI, because a FontFamily resource cannot take another resource as its value. -->
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/CascadiaMono.ttf#Cascadia Mono</FontFamily>
            <FontFamily x:Key="ControlContentThemeFontFamily">ms-appx:///Assets/Fonts/CascadiaMono.ttf#Cascadia Mono</FontFamily>

            <!-- Cascadia Mono renders larger than WinUI's default sans at the same point size, so
                 the control-content size drops a notch to compensate. -->
            <x:Double x:Key="ControlContentThemeFontSize">12.5</x:Double>

            <!-- Applies to every TextBlock without an explicit Style. An implicit style is safe here
                 because TextBlock has no control template. The keyed styles below repeat the
                 FontFamily setter, since a keyed style opts out of the implicit one. -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BrandFont}"/>
            </Style>

            <tb:TaskbarIcon
                x:Key="TrayIcon"
                ToolTipText="ChargeKeeper"
                NoLeftClickDelay="True"/>

            <!-- The uppercase stat caption and the value beneath it, shared by DashboardWindow,
                 BatteryHistoryWindow and BatteryHealthPanel so the stat typography is tuned once.
                 Application-level, so every window and UserControl resolves them. -->
            <Style x:Key="StatLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BrandFont}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
                <Setter Property="CharacterSpacing" Value="100"/>
            </Style>
            <Style x:Key="StatValueStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BrandFont}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
            </Style>

            <!-- One heading treatment for both surfaces: colour, weight and tracking are shared and
                 only the size differs, so the dashboard popup and the Settings window carry the same
                 hierarchy at their own scales. Each heading sits about 1.2x its surface's body size.

                 Teal, not the steel accent: AppColors.AccentBrush marks the preset in force, and a
                 heading in that colour would compete with the one thing on the page that means
                 "running right now". Headings are chrome, so they take a chrome colour. -->
            <StaticResource x:Key="SectionHeadingBrush" ResourceKey="BrandTealBrush"/>

            <Style x:Key="HeadingBaseStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BrandFont}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="CharacterSpacing" Value="40"/>
                <Setter Property="Foreground" Value="{StaticResource SectionHeadingBrush}"/>
            </Style>

            <!-- The Settings page title, a level above a section heading and present on that surface
                 only. Size and weight both step up, because one axis alone reads as a rendering
                 accident rather than a hierarchy. -->
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource HeadingBaseStyle}">
                <Setter Property="FontSize" Value="19"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>

            <!-- Section headings: 15 over the 12.5 control-content size in Settings, 13 over the 11 px
                 detail lines on the dashboard. -->
            <Style x:Key="SubHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource HeadingBaseStyle}">
                <Setter Property="FontSize" Value="15"/>
            </Style>
            <Style x:Key="DashboardHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource HeadingBaseStyle}">
                <Setter Property="FontSize" Value="13"/>
            </Style>

            <!-- Marks where one sub-section ends and the next begins. The whole gap between groups
                 sits above the rule and the heading, so a heading binds downwards to its own cards
                 rather than floating between two groups. -->
            <Style x:Key="SectionDividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                <Setter Property="Margin" Value="0,24,0,12"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
