<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Everything this repository restores comes from nuget.org: the shared library arrives as a
       project reference on the sibling checkout, not as a package. Clearing inherited sources keeps
       a machine-level feed out of the graph and settles NU1507, which central package management
       raises whenever more than one source can answer for a package. -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

</configuration>
